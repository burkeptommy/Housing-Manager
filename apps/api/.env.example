# Haven Home Manager API - Environment Variables

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/haven_db?schema=public"

# =============================================================================
# APPLICATION
# =============================================================================
# Server port
PORT=4000

# Node environment (development, production, test)
NODE_ENV=development

# CORS origin (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT secret key (generate with: openssl rand -base64 64)
# IMPORTANT: Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production-must-be-at-least-32-characters

# Access token expiration time in seconds (default: 900 = 15 minutes)
JWT_ACCESS_EXPIRES_IN=900

# Refresh token expiration time in days (default: 7 days)
JWT_REFRESH_EXPIRES_DAYS=7

# =============================================================================
# STRIPE BILLING
# =============================================================================
# Stripe API keys (get from https://dashboard.stripe.com/apikeys)
# Use test keys for development, live keys for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook signing secret (get from https://dashboard.stripe.com/webhooks)
# Required for verifying webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe Price IDs for subscription tiers
# Create these in Stripe Dashboard under Products > Prices
# STRIPE_PRICE_BASIC=price_xxx
# STRIPE_PRICE_PREMIUM=price_xxx
# STRIPE_PRICE_ENTERPRISE=price_xxx

# =============================================================================
# NOTIFICATIONS (for future use)
# =============================================================================
# SendGrid API key for email notifications
# SENDGRID_API_KEY=SG.xxx

# Twilio credentials for SMS notifications
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_PHONE_NUMBER=+1234567890

# Firebase Cloud Messaging for push notifications
# FIREBASE_PROJECT_ID=xxx
# FIREBASE_PRIVATE_KEY=xxx
# FIREBASE_CLIENT_EMAIL=xxx

# =============================================================================
# FIREBASE AUTHENTICATION
# =============================================================================
# Firebase project ID for authentication
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Auth emulator (for local development only)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# =============================================================================
# CRON / SCHEDULED JOBS
# =============================================================================
# Secret for protecting internal cron endpoints (generate with: openssl rand -hex 32)
# Required for Cloud Scheduler to call /internal/cron/run-reminder-jobs
CRON_SECRET=your-cron-secret-change-in-production

# =============================================================================
# FRONTEND URLS
# =============================================================================
# Base URL for the web frontend (used for email links, redirects)
FRONTEND_BASE_URL=http://localhost:3000

# Base URL for mobile API (if different from main API)
# MOBILE_API_BASE_URL=http://localhost:4000/api

# =============================================================================
# GOOGLE CLOUD STORAGE
# =============================================================================
# GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# GCS bucket name for file uploads
GCS_BUCKET_NAME=haven-uploads

# Path to GCP service account key file (for local development only)
# Not needed in Cloud Run if using Workload Identity
# GCS_KEY_FILE=./gcp-service-account.json

# =============================================================================
# GOOGLE MAPS (Geocoding for Social Engine)
# =============================================================================
# Google Maps API key for geocoding addresses to coordinates
# Required for H3 neighbor matching in the Social Engine feature
# Get from: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# =============================================================================
# ANTHROPIC (AI Features - Alfred AI Home Manager)
# =============================================================================
# Anthropic API key for Claude AI integration
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# =============================================================================
# REDIS (optional - for caching and websocket scaling)
# =============================================================================
# REDIS_URL=redis://localhost:6379
