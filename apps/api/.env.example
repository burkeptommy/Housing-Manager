# Haven Home Manager API - Environment Variables

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/haven_db?schema=public"

# =============================================================================
# APPLICATION
# =============================================================================
# Server port
PORT=4000

# Node environment (development, production, test)
NODE_ENV=development

# CORS origin (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# AUTHENTICATION (for future use)
# =============================================================================
# JWT secret key (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT expiration time
JWT_EXPIRES_IN=7d

# =============================================================================
# STRIPE (for future use)
# =============================================================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# FILE STORAGE (for future use)
# =============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=haven-files
