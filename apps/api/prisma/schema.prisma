// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id              String    @id @default(cuid())
  firebaseUid     String?   @unique @map("firebase_uid") // Firebase Auth UID
  email           String    @unique
  passwordHash    String?   @map("password_hash") // Optional for Firebase-only auth
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  displayName     String?   @map("display_name") // From Firebase or derived
  phone           String?
  avatarUrl       String?   @map("avatar_url")
  role            UserRole  @default(HOMEOWNER)
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Social Engine fields
  isPublicProfile  Boolean  @default(false) @map("is_public_profile")
  influencerBadges String[] @default([]) @map("influencer_badges") // e.g., ["top_contributor", "verified_pro"]
  bio              String? // Short user bio for profile

  // Relations
  householdMembers   HouseholdMember[]   @relation("MemberUser")
  invitedMembers     HouseholdMember[]   @relation("InvitedByUser")
  sentInvites        HouseholdInvite[]
  ownedHouseholds    Household[]         @relation("HouseholdOwner")
  managedHouseholds  Household[]         @relation("HouseholdManager")
  handymanHouseholds Household[]         @relation("HouseholdHandyman") // Households where user is assigned handyman
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  serviceRequests    ServiceRequest[]    @relation("ServiceRequestCreator")
  sentMessages       Message[]           @relation("MessageSender")
  subscriptions      Subscription[]
  files              File[]
  refreshTokens      RefreshToken[]
  inAppNotifications InAppNotification[]

  // Support chat relations
  createdConversations   Conversation[]          @relation("ConversationCreator")
  supportMessages        SupportMessage[]        @relation("SupportMessageSender")
  homeManagerAssignments HomeManagerAssignment[] @relation("AssignedHomeManager")
  madeAssignments        HomeManagerAssignment[] @relation("AssignmentMadeBy")

  // Work order relations
  createdWorkOrders  WorkOrder[]     @relation("WorkOrderCreator")
  verifiedWorkOrders WorkOrder[]     @relation("WorkOrderVerifier")
  handymanWorkOrders WorkOrder[]     @relation("WorkOrderHandyman") // Work orders assigned to this handyman
  workOrderNotes     WorkOrderNote[] @relation("WorkOrderNoteAuthor")

  // File asset relations
  uploadedFileAssets FileAsset[] @relation("FileAssetUploader")

  // Financial engine relations
  managedTransactions  Transaction[] @relation("TransactionManager")
  handymanTransactions Transaction[] @relation("TransactionHandyman") // Transactions for work done as handyman

  // Vendor portal relation
  vendorProfile Vendor? @relation("VendorUser")

  // Social Engine relations
  friendshipsInitiated Friendship[]  @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]  @relation("FriendshipAddressee")
  following            Follow[]      @relation("FollowerUser")
  followers            Follow[]      @relation("FollowedUser")
  projectPosts         ProjectPost[] @relation("ProjectPostAuthor")
  savedPosts           SavedPost[]   @relation("SavedPostUser")
  projectLikes         ProjectLike[] @relation("ProjectLikeUser")
  postComments         PostComment[] @relation("PostCommentAuthor")

  // Project Planner relations
  projectIdeas           ProjectIdea[]           @relation("ProjectIdeaCreator")
  recommendationRequests RecommendationRequest[] @relation("RecommendationRequestCreator")
  vendorSuggestions      VendorSuggestion[]      @relation("VendorSuggestionSuggestor")

  // Concierge / AI Triage relations
  inboundRequestsSent     InboundRequest[]  @relation("InboundRequestSender")
  inboundRequestsResolved InboundRequest[]  @relation("InboundRequestResolver")
  conciergeThreads        ConciergeThread[]
  familyEvents            FamilyEvent[]

  // Travel Concierge relations
  tripsCreated           Trip[]              @relation("TripCreator")
  tripsManaged           Trip[]              @relation("TripManager")
  tripProposalsCreated   TripProposal[]      @relation("TripProposalCreator")
  assignedProtocols      HouseProtocol[]     @relation("ProtocolAssignee")
  protocolItemsCompleted HouseProtocolItem[] @relation("ProtocolItemCompleter")

  // Intake checklist completions (Home Manager)
  completedChecklists HomeChecklist[] @relation("ChecklistCompletedBy")

  // Household Intake / Onboarding Workbench
  intakesManaged HouseholdIntake[] @relation("IntakeManager")

  // Zone-based onboarding progress
  onboardingManagedAs   OnboardingProgress[] @relation("OnboardingHomeManager")
  onboardingHandymanFor OnboardingProgress[] @relation("OnboardingHandyman")

  // Approval System relations
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequestedBy")
  decidedApprovals   ApprovalRequest[] @relation("ApprovalDecidedBy")
  approvalComments   ApprovalComment[] @relation("ApprovalCommentAuthor")

  // Maintenance Task completion relation
  completedMaintenanceTasks MaintenanceTask[] @relation("MaintenanceTaskCompletedBy")

  // Document Vault relations
  uploadedDocuments Document[] @relation("DocumentUploader")

  // Referral relations
  referralsSent     Referral[] @relation("ReferralReferrer") // Referrals this user has sent
  referredBy        Referral[] @relation("ReferralReferee") // How this user was referred
  referralCode      String?    @unique @map("referral_code") // User's unique referral code

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

