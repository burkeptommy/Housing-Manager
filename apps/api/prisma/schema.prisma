// Work order status - State machine: OPEN -> ASSIGNED -> IN_PROGRESS -> COMPLETED -> VERIFIED
enum WorkOrderStatus {
  DRAFT
  REQUESTED
  SCHEDULED
  OPEN // Available for vendors to claim
  ASSIGNED // Vendor has accepted the job
  IN_PROGRESS // Vendor checked in and working
  COMPLETED // Vendor finished, awaiting verification
  VERIFIED // Manager approved the work
  CANCELLED
}

// Work order billing type - determines if client pays or it's inclusive in subscription
enum WorkOrderBillingType {
  BILLABLE_TO_CLIENT // Client pays for this work
  INCLUSIVE // Included in subscription, company absorbs cost
}

// Service category tier - determines routing and billing
enum ServiceCategoryTier {
  MINOR_MAINTENANCE // Small tasks: filter changes, loose hinges, etc. (Inclusive)
  MAJOR_REPAIR // Larger repairs requiring skilled labor (Billable)
  SPECIALIZED // Requires licensed professional (Billable, external vendor)
}

// Transaction payout method - how the company paid the vendor
enum TransactionPayoutMethod {
  CHECKBOOK_IO // Checkbook.io digital check
  STRIPE // Stripe transfer
  CASH // Cash payment
  COMPANY_CARD // Company credit card
  BANK_TRANSFER // Direct bank transfer
}

// Transaction status - lifecycle of expense reimbursement
enum TransactionStatus {
  PENDING // Created but not yet paid to vendor
  PAID_TO_VENDOR // Company has paid the vendor
  BILLED_TO_CLIENT // Added to client's monthly invoice
  SETTLED // Client has reimbursed the company
  CANCELLED // Transaction cancelled
}

