// Haven Home Manager - Prisma Schema
// PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  HOMEOWNER
  MANAGER
  VENDOR
}

enum HouseholdRole {
  OWNER
  MEMBER
  GUEST
}

enum HouseholdMemberStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum PropertyType {
  SINGLE_FAMILY
  CONDO
  TOWNHOUSE
  APARTMENT
  MULTI_FAMILY
  MOBILE_HOME
  OTHER
}

enum ServiceRequestStatus {
  DRAFT
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUALLY
  ANNUALLY
}

enum MaintenanceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUALLY
  ANNUALLY
}

enum SubscriptionTier {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum MessageType {
  TEXT
  SYSTEM
  SERVICE_UPDATE
}

enum ChannelType {
  HOUSEHOLD
  REQUEST
}

enum FileCategory {
  DOCUMENT
  IMAGE
  RECEIPT
  WARRANTY
  MANUAL
  CONTRACT
  OTHER
}

// Vendor Categories - comprehensive list for bills and services
enum VendorCategory {
  // Housing & Mortgage
  MORTGAGE
  HOA
  PROPERTY_TAX

  // Utilities
  ELECTRIC
  GAS
  WATER_SEWER
  TRASH
  INTERNET
  MOBILE
  CABLE

  // Insurance
  HOME_INSURANCE
  AUTO_INSURANCE
  HEALTH_INSURANCE
  LIFE_INSURANCE
  PET_INSURANCE

  // Loans & Credit
  CREDIT_CARD
  STUDENT_LOAN
  PERSONAL_LOAN
  VEHICLE_LOAN
  HELOC

  // Subscriptions & Services
  STREAMING
  GYM
  SECURITY_MONITORING
  PEST_CONTROL
  LAWN_CARE
  LANDSCAPING
  HOME_WARRANTY

  // Home Services
  CLEANING
  WINDOW_WASHING
  GUTTER_CLEANING
  HVAC_SERVICE
  FILTER_SERVICE
  CHIMNEY_SWEEP
  SEPTIC_SERVICE
  POOL_SERVICE
  SNOW_REMOVAL
  HANDYMAN

  OTHER
}

enum BillingFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUALLY
  ANNUAL
  PER_VISIT
  PER_JOB
  OTHER
}

enum PaymentResponsibility {
  OWNER_PAYS_DIRECT        // We just track and remind
  HAVEN_PAYS_ON_BEHALF     // We collect money and pay vendor
  VENDOR_AUTOPAY           // Autopay is set up with vendor, we track and alert
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
}

enum MaintenanceCategory {
  HVAC
  PLUMBING
  ROOF_GUTTER
  CHIMNEY
  SEPTIC
  LANDSCAPING
  PEST
  POOL
  SAFETY
  CLEANING
  APPLIANCES
  EXTERIOR
  INTERIOR
  GENERAL
}

enum MaintenanceTaskStatus {
  PENDING
  SCHEDULED
  COMPLETED
  SKIPPED
  OVERDUE
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  phone             String?
  avatarUrl         String?   @map("avatar_url")
  role              UserRole  @default(HOMEOWNER)
  emailVerified     Boolean   @default(false) @map("email_verified")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  householdMembers  HouseholdMember[]
  ownedHouseholds   Household[]         @relation("HouseholdOwner")
  assignedTasks     Task[]              @relation("TaskAssignee")
  createdTasks      Task[]              @relation("TaskCreator")
  serviceRequests   ServiceRequest[]    @relation("ServiceRequestCreator")
  sentMessages      Message[]           @relation("MessageSender")
  subscriptions     Subscription[]
  files             File[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  token       String   @unique
  expiresAt   DateTime @map("expires_at")
  isRevoked   Boolean  @default(false) @map("is_revoked")
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================================================
// HOUSEHOLD & MEMBERS
// ============================================================================

model Household {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner             User              @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members           HouseholdMember[]
  homeProfile       HomeProfile?
  vendors           HouseholdVendor[]
  ownedVendors      Vendor[]          @relation("HouseholdVendors")
  serviceRequests   ServiceRequest[]
  tasks             Task[]
  maintenancePlans  MaintenancePlan[]
  invoices          Invoice[]
  files             File[]
  messages          Message[]
  billAccounts      BillAccount[]
  paymentMethods    PaymentMethod[]
  maintenanceTasks  MaintenanceTask[]

  @@map("households")
}

model HouseholdMember {
  id          String                @id @default(cuid())
  householdId String                @map("household_id")
  userId      String                @map("user_id")
  role        HouseholdRole         @default(MEMBER)
  status      HouseholdMemberStatus @default(PENDING)
  invitedAt   DateTime              @default(now()) @map("invited_at")
  joinedAt    DateTime?             @map("joined_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@map("household_members")
}

// ============================================================================
// HOME PROFILE
// ============================================================================

model HomeProfile {
  id              String       @id @default(cuid())
  householdId     String       @unique @map("household_id")
  propertyType    PropertyType @default(SINGLE_FAMILY) @map("property_type")

  // Address
  addressLine1    String       @map("address_line_1")
  addressLine2    String?      @map("address_line_2")
  city            String
  state           String
  postalCode      String       @map("postal_code")
  country         String       @default("US")

  // Property Details
  squareFeet      Int?         @map("square_feet")
  lotSize         Float?       @map("lot_size")
  yearBuilt       Int?         @map("year_built")
  bedrooms        Int?
  bathrooms       Float?
  stories         Int?
  garageSpaces    Int?         @map("garage_spaces")

  // Additional Info
  purchaseDate    DateTime?    @map("purchase_date")
  purchasePrice   Decimal?     @map("purchase_price") @db.Decimal(12, 2)
  currentValue    Decimal?     @map("current_value") @db.Decimal(12, 2)
  notes           String?

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  household       Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("home_profiles")
}

// ============================================================================
// VENDORS & SERVICES
// ============================================================================

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  vendors         Vendor[]
  serviceRequests ServiceRequest[]
  maintenancePlans MaintenancePlan[]

  @@map("service_categories")
}

model Vendor {
  id                  String          @id @default(cuid())
  householdId         String?         @map("household_id")  // If set, vendor is private to this household
  displayName         String          @map("display_name")
  category            VendorCategory  @default(OTHER)
  serviceDescription  String?         @map("service_description")
  isLocal             Boolean         @default(true) @map("is_local")

  // Contact Info
  contactName         String?         @map("contact_name")
  email               String?
  phone               String?
  websiteUrl          String?         @map("website_url")

  // Address
  addressLine1        String?         @map("address_line_1")
  addressLine2        String?         @map("address_line_2")
  city                String?
  state               String?
  postalCode          String?         @map("postal_code")
  country             String?         @default("US")

  // Business Info
  licenseNumber       String?         @map("license_number")
  insuranceInfo       String?         @map("insurance_info")
  rating              Float?          @db.Real
  reviewCount         Int             @default(0) @map("review_count")

  // Legacy field - keep for backward compatibility
  serviceCategoryId   String?         @map("service_category_id")
  isVerified          Boolean         @default(false) @map("is_verified")
  isActive            Boolean         @default(true) @map("is_active")
  notes               String?

  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // Relations
  household           Household?      @relation("HouseholdVendors", fields: [householdId], references: [id], onDelete: Cascade)
  serviceCategory     ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  householdVendors    HouseholdVendor[]
  serviceRequests     ServiceRequest[]
  messages            Message[]
  billAccounts        BillAccount[]
  maintenanceTasks    MaintenanceTask[]

  @@index([householdId, category])
  @@map("vendors")
}

model HouseholdVendor {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  vendorId    String   @map("vendor_id")
  notes       String?
  isFavorite  Boolean  @default(false) @map("is_favorite")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([householdId, vendorId])
  @@map("household_vendors")
}

// ============================================================================
// SERVICE REQUESTS
// ============================================================================

model ServiceRequest {
  id                String                 @id @default(cuid())
  householdId       String                 @map("household_id")
  serviceCategoryId String?                @map("service_category_id")
  vendorId          String?                @map("vendor_id")
  createdById       String                 @map("created_by_id")

  title             String
  description       String
  status            ServiceRequestStatus   @default(DRAFT)
  priority          ServiceRequestPriority @default(MEDIUM)

  // Scheduling
  preferredDate     DateTime?              @map("preferred_date")
  scheduledDate     DateTime?              @map("scheduled_date")
  completedDate     DateTime?              @map("completed_date")

  // Cost
  estimatedCost     Decimal?               @map("estimated_cost") @db.Decimal(10, 2)
  actualCost        Decimal?               @map("actual_cost") @db.Decimal(10, 2)

  notes             String?

  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  // Relations
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("ServiceRequestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages        Message[]
  files           File[]

  @@index([householdId, status])
  @@index([vendorId, status])
  @@map("service_requests")
}

// ============================================================================
// TASKS
// ============================================================================

model Task {
  id              String         @id @default(cuid())
  householdId     String         @map("household_id")
  createdById     String         @map("created_by_id")
  assigneeId      String?        @map("assignee_id")

  title           String
  description     String?
  status          TaskStatus     @default(PENDING)
  priority        TaskPriority   @default(MEDIUM)

  // Scheduling
  dueDate         DateTime?      @map("due_date")
  completedAt     DateTime?      @map("completed_at")

  // Recurrence
  recurrence      TaskRecurrence @default(NONE)
  nextOccurrence  DateTime?      @map("next_occurrence")

  // Linking
  roomName        String?        @map("room_name")

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  files     File[]

  @@index([householdId, status])
  @@index([assigneeId, status])
  @@map("tasks")
}

// ============================================================================
// MAINTENANCE PLANS
// ============================================================================

model MaintenancePlan {
  id                String               @id @default(cuid())
  householdId       String               @map("household_id")
  serviceCategoryId String?              @map("service_category_id")

  name              String
  description       String?
  frequency         MaintenanceFrequency

  // Scheduling
  lastCompletedAt   DateTime?            @map("last_completed_at")
  nextDueDate       DateTime?            @map("next_due_date")

  // Cost tracking
  estimatedCost     Decimal?             @map("estimated_cost") @db.Decimal(10, 2)

  isActive          Boolean              @default(true) @map("is_active")
  notes             String?

  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  // Relations
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)

  @@index([householdId, isActive])
  @@map("maintenance_plans")
}

// ============================================================================
// MESSAGING
// ============================================================================

model Message {
  id               String      @id @default(cuid())

  // Channel identification - either household or service request
  channelType      ChannelType @map("channel_type")
  householdId      String?     @map("household_id")
  serviceRequestId String?     @map("service_request_id")

  senderId         String?     @map("sender_id")
  vendorId         String?     @map("vendor_id")

  content          String
  messageType      MessageType @default(TEXT) @map("message_type")
  isRead           Boolean     @default(false) @map("is_read")
  readAt           DateTime?   @map("read_at")

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // Relations
  household      Household?      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  sender         User?           @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  vendor         Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([channelType, householdId, createdAt])
  @@index([channelType, serviceRequestId, createdAt])
  @@map("messages")
}

// ============================================================================
// SUBSCRIPTIONS & BILLING
// ============================================================================

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @map("user_id")

  tier                SubscriptionTier   @default(FREE)
  status              SubscriptionStatus @default(ACTIVE)

  // Billing Period
  currentPeriodStart  DateTime           @map("current_period_start")
  currentPeriodEnd    DateTime           @map("current_period_end")

  // Payment
  stripeCustomerId    String?            @map("stripe_customer_id")
  stripeSubscriptionId String?           @map("stripe_subscription_id")

  cancelledAt         DateTime?          @map("cancelled_at")
  cancelAtPeriodEnd   Boolean            @default(false) @map("cancel_at_period_end")

  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

model Invoice {
  id            String        @id @default(cuid())
  householdId   String        @map("household_id")

  invoiceNumber String        @unique @map("invoice_number")
  status        InvoiceStatus @default(DRAFT)

  // Amounts
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)

  // Dates
  issuedAt      DateTime?     @map("issued_at")
  dueDate       DateTime?     @map("due_date")
  paidAt        DateTime?     @map("paid_at")

  // Payment
  paymentMethod String?       @map("payment_method")
  paymentRef    String?       @map("payment_ref")

  notes         String?

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  files     File[]

  @@index([householdId, status])
  @@map("invoices")
}

// ============================================================================
// FILE MANAGEMENT
// ============================================================================

model File {
  id               String       @id @default(cuid())
  userId           String?      @map("user_id")
  householdId      String?      @map("household_id")
  serviceRequestId String?      @map("service_request_id")
  taskId           String?      @map("task_id")
  invoiceId        String?      @map("invoice_id")

  filename         String
  originalName     String       @map("original_name")
  mimeType         String       @map("mime_type")
  size             Int
  url              String?                           // Public URL (if applicable)
  gcsUri           String?      @map("gcs_uri")      // gs://bucket/path format
  category         FileCategory @default(DOCUMENT)

  description      String?

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relations
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  household      Household?      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([householdId, category])
  @@map("files")
}

// ============================================================================
// PAYMENT METHODS
// ============================================================================

model PaymentMethod {
  id                    String            @id @default(cuid())
  householdId           String            @map("household_id")

  stripeCustomerId      String            @map("stripe_customer_id")
  stripePaymentMethodId String            @map("stripe_payment_method_id")

  label                 String            // e.g. "Chase Checking", "Amex Blue"
  type                  PaymentMethodType @default(CARD)
  last4                 String
  expMonth              Int?              @map("exp_month")  // For cards only
  expYear               Int?              @map("exp_year")   // For cards only
  bankName              String?           @map("bank_name")  // For bank accounts

  isDefaultForSubscription Boolean        @default(false) @map("is_default_for_subscription")
  isActive              Boolean           @default(true) @map("is_active")

  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  // Relations
  household             Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  billAccounts          BillAccount[]

  @@index([householdId])
  @@map("payment_methods")
}

// ============================================================================
// BILL ACCOUNTS
// ============================================================================

model BillAccount {
  id                      String                @id @default(cuid())
  householdId             String                @map("household_id")
  vendorId                String                @map("vendor_id")
  paymentMethodId         String?               @map("payment_method_id")

  nickname                String                // e.g. "Primary Mortgage", "Front Lawn Care"
  category                VendorCategory        @default(OTHER)
  accountNumber           String?               @map("account_number")

  // Billing Details
  billingFrequency        BillingFrequency      @default(MONTHLY) @map("billing_frequency")
  paymentResponsibility   PaymentResponsibility @default(OWNER_PAYS_DIRECT) @map("payment_responsibility")
  typicalAmount           Decimal?              @map("typical_amount") @db.Decimal(10, 2)
  nextDueDate             DateTime?             @map("next_due_date")

  // Autopay Settings
  autopayEnabled          Boolean               @default(false) @map("autopay_enabled")

  // Portal & Support
  portalUrl               String?               @map("portal_url")
  supportPhone            String?               @map("support_phone")

  notes                   String?
  isActive                Boolean               @default(true) @map("is_active")

  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  deletedAt               DateTime?             @map("deleted_at")  // Soft delete

  // Relations
  household               Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendor                  Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  autopayPaymentMethod    PaymentMethod?        @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([householdId, category])
  @@index([householdId, nextDueDate])
  @@map("bill_accounts")
}

// ============================================================================
// MAINTENANCE TEMPLATES & TASKS
// ============================================================================

model MaintenanceTemplate {
  id                        String              @id @default(cuid())
  slug                      String              @unique  // e.g. "hvac_tuneup", "chimney_sweep"
  title                     String
  description               String?
  category                  MaintenanceCategory @default(GENERAL)

  // Recommended Schedule
  recommendedFrequencyMonths Int?               @map("recommended_frequency_months")
  recommendedSeasonStartMonth Int?              @map("recommended_season_start_month")  // 1-12
  recommendedSeasonEndMonth  Int?               @map("recommended_season_end_month")    // 1-12

  // Property conditions that trigger this template (stored as JSON)
  // e.g. { "has_septic": true, "has_pool": true, "climate_zone": "cold" }
  propertyConditionsJson    Json?               @map("property_conditions_json")

  // Default vendor category for this type of maintenance
  defaultVendorCategory     VendorCategory?     @map("default_vendor_category")

  // Estimated costs
  estimatedCostMin          Decimal?            @map("estimated_cost_min") @db.Decimal(10, 2)
  estimatedCostMax          Decimal?            @map("estimated_cost_max") @db.Decimal(10, 2)

  isActive                  Boolean             @default(true) @map("is_active")
  sortOrder                 Int                 @default(0) @map("sort_order")

  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  // Relations
  maintenanceTasks          MaintenanceTask[]

  @@map("maintenance_templates")
}

model MaintenanceTask {
  id                    String                @id @default(cuid())
  householdId           String                @map("household_id")
  templateId            String?               @map("template_id")  // Nullable if custom task
  assignedVendorId      String?               @map("assigned_vendor_id")

  title                 String
  description           String?
  category              MaintenanceCategory   @default(GENERAL)
  status                MaintenanceTaskStatus @default(PENDING)

  // Scheduling
  dueDate               DateTime?             @map("due_date")
  scheduledDate         DateTime?             @map("scheduled_date")
  completedAt           DateTime?             @map("completed_at")

  // Cost Tracking
  estimatedCost         Decimal?              @map("estimated_cost") @db.Decimal(10, 2)
  actualCost            Decimal?              @map("actual_cost") @db.Decimal(10, 2)

  // Template tracking
  createdFromTemplate   Boolean               @default(false) @map("created_from_template")

  notes                 String?
  priority              TaskPriority          @default(MEDIUM)

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  // Relations
  household             Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  template              MaintenanceTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignedVendor        Vendor?               @relation(fields: [assignedVendorId], references: [id], onDelete: SetNull)

  @@index([householdId, status])
  @@index([householdId, dueDate])
  @@index([householdId, category])
  @@map("maintenance_tasks")
}
