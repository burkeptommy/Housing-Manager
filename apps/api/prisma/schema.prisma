// ============================================================================
// HOUSEHOLD & MEMBERS
// ============================================================================

model Household {
  id                 String   @id @default(cuid())
  name               String // e.g. "The Burke family"
  description        String?
  ownerId            String   @map("owner_id")
  managerId          String?  @map("manager_id") // Assigned Haven staff member (Home Manager)
  assignedHandymanId String?  @map("assigned_handyman_id") // Assigned handyman for concierge/minor maintenance
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Social Engine - Geospatial for neighbor matching (H3 Resolution 8 = ~460m hexagons)
  h3Index String? @map("h3_index")

  // Stripe Integration - Haven is a Stripe platform; each household is a customer
  stripeCustomerId String? @unique @map("stripe_customer_id")

  // Subscription
  subscriptionPlan   HouseholdSubscriptionPlan   @default(FREE) @map("subscription_plan")
  subscriptionStatus HouseholdSubscriptionStatus @default(INACTIVE) @map("subscription_status")

  // Concierge Settings
  conciergeEnabled Boolean @default(false) @map("concierge_enabled") // Is concierge service active?
  monthlyVisitDay  Int?    @map("monthly_visit_day") // Day of month for scheduled maintenance visit (1-28)

  // Billing Settings
  // Day of month (1-28) when consolidated invoice is generated
  billingCycleDay Int   @default(1) @map("billing_cycle_day")
  // JSON for additional billing settings (auto-pay limits, preferences, etc.)
  billingSettings Json? @map("billing_settings")

  // Relations
  owner             User               @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  manager           User?              @relation("HouseholdManager", fields: [managerId], references: [id], onDelete: SetNull)
  assignedHandyman  User?              @relation("HouseholdHandyman", fields: [assignedHandymanId], references: [id], onDelete: SetNull)
  members           HouseholdMember[]
  invites           HouseholdInvite[]
  homeProfile       HomeProfile?
  vendors           HouseholdVendor[]
  ownedVendors      Vendor[]           @relation("HouseholdVendors")
  serviceRequests   ServiceRequest[]
  tasks             Task[]
  maintenancePlans  MaintenancePlan[]
  invoices          Invoice[]
  householdInvoices HouseholdInvoice[]
  files             File[]
  messages          Message[]
  billAccounts      BillAccount[]
  paymentMethods    PaymentMethod[]
  maintenanceTasks  MaintenanceTask[]
  reminders         Reminder[]
  conversations     Conversation[]
  workOrders        WorkOrder[]
  fileAssets        FileAsset[]

  // Financial engine relations
  clientBankAccounts ClientBankAccount[]
  transactions       Transaction[]

  // Social Engine relations
  projectPosts ProjectPost[]

  // Vehicle relations
  vehicles Vehicle[]

  // Project Planner relations
  projectIdeas           ProjectIdea[]
  recommendationRequests RecommendationRequest[]

  // Concierge / AI Triage relations
  inboundRequests  InboundRequest[]
  conciergeThreads ConciergeThread[]
  familyEvents     FamilyEvent[]

  // Travel Concierge relations
  trips          Trip[]
  houseProtocols HouseProtocol[]

  // Family Assets relations
  pets        Pet[]
  homeSystems HomeSystem[]

  // Property Enrichment from ATTOM (stored for reference)
  enrichmentData Json? @map("enrichment_data")

  // Alfred-First Data Capture
  // Utility Providers (from ZIP lookup + Plaid confirmation)
  electricityProvider    String? @map("electricity_provider")
  electricityConfirmed   Boolean @default(false) @map("electricity_confirmed")
  gasProvider            String? @map("gas_provider")
  gasConfirmed           Boolean @default(false) @map("gas_confirmed")
  waterSource            String? @map("water_source") // "well" or "municipal"
  waterSourceConfirmed   Boolean @default(false) @map("water_source_confirmed")
  waterProvider          String? @map("water_provider")
  sewerType              String? @map("sewer_type") // "septic" or "municipal"
  sewerTypeConfirmed     Boolean @default(false) @map("sewer_type_confirmed")
  sewerProvider          String? @map("sewer_provider")
  heatingFuel            String? @map("heating_fuel") // "oil", "natural-gas", "propane", "electric"
  heatingFuelProvider    String? @map("heating_fuel_provider")
  internetProvider       String? @map("internet_provider")
  cableProvider          String? @map("cable_provider")

  // Plaid-detected financial info
  mortgageProvider       String?   @map("mortgage_provider")
  mortgageMonthlyPayment Float?    @map("mortgage_monthly_payment")
  mortgageDetectedAt     DateTime? @map("mortgage_detected_at")
  insuranceProvider      String?   @map("insurance_provider")
  insurancePaymentAmount Float?    @map("insurance_payment_amount")
  insurancePaymentFreq   String?   @map("insurance_payment_freq")
  insuranceDetectedAt    DateTime? @map("insurance_detected_at")

  // Home Health Score
  homeHealthScore Int? @default(85) @map("home_health_score")

  // Property Photo (main photo for household)
  propertyPhotoUrl String? @map("property_photo_url")

  // Data Capture Status
  attomDataFetched     Boolean @default(false) @map("attom_data_fetched")
  plaidDataAnalyzed    Boolean @default(false) @map("plaid_data_analyzed")
  initialSetupComplete Boolean @default(false) @map("initial_setup_complete")

  // Alfred Progressive Questions
  alfredQuestionsAsked Json? @map("alfred_questions_asked") // Array of question IDs asked
  alfredDataGaps       Json? @map("alfred_data_gaps") // Array of data gaps to fill

  // Intake checklist for Home Manager
  intakeChecklist HomeChecklist?

  // Household Intake / Onboarding Workbench
  householdIntake  HouseholdIntake?
  familyMembers    FamilyMember[]
  familyActivities FamilyActivity[]
  memberships      Membership[]

  // Zone-based property structure
  zones              Zone[]
  propertyAssets     PropertyAsset[]
  serviceLogs        ServiceLog[]
  propertyDocuments  PropertyDocument[]
  onboardingProgress OnboardingProgress?

  // Comprehensive Bills & Payments
  comprehensiveBills ComprehensiveBill[]
  kidActivities      KidActivity[]

  // Activity Log
  activityLogs ActivityLog[]

  // Approval System
  approvalRequests ApprovalRequest[]

  // Document Vault
  documents Document[]

  // Plaid Integration
  plaidConnections PlaidConnection[]
  detectedBills    DetectedBill[]

  // Payment System
  card              HouseholdCard?
  bills             Bill[]
  paymentApprovals  PaymentApproval[]

  @@index([managerId])
  @@index([assignedHandymanId])
  @@index([h3Index])
  @@map("households")
}

model HouseholdMember {
  id              String                @id @default(cuid())
  householdId     String                @map("household_id")
  userId          String                @map("user_id")
  role            HouseholdRole         @default(MEMBER)
  status          HouseholdMemberStatus @default(PENDING)
  invitedByUserId String?               @map("invited_by_user_id")
  invitedAt       DateTime              @default(now()) @map("invited_at")
  acceptedAt      DateTime?             @map("accepted_at")
  joinedAt        DateTime?             @map("joined_at")

  // Member Profile (for concierge shopping, gift planning, etc.)
  nickname            String? // How they're referred to in the household
  birthday            DateTime? @db.Date
  shirtSize           String?   @map("shirt_size") // XS, S, M, L, XL, XXL
  pantSize            String?   @map("pant_size")
  shoeSize            String?   @map("shoe_size")
  dietaryRestrictions String[]  @default([]) @map("dietary_restrictions") // vegetarian, gluten-free, etc.
  allergies           String[]  @default([]) // peanuts, shellfish, etc.
  medicalNotes        String?   @map("medical_notes") @db.Text // Private medical info
  favoriteColor       String?   @map("favorite_color")
  interests           String[]  @default([]) // For gift suggestions
  profilePhotoUrl     String?   @map("profile_photo_url")

  // Work/Employment Info (for adults)
  employer     String? // Company name
  jobTitle     String? @map("job_title")
  workAddress  String? @map("work_address")
  workPhone    String? @map("work_phone")
  workSchedule String? @map("work_schedule") // e.g., "Mon-Fri 9am-5pm"
  commuteMiles Float?  @map("commute_miles")

  // Extended Health Info
  primaryPhysician  String? @map("primary_physician")
  physicianPhone    String? @map("physician_phone")
  dentist           String?
  dentistPhone      String? @map("dentist_phone")
  bloodType         String? @map("blood_type")
  insuranceProvider String? @map("insurance_provider")
  insuranceNumber   String? @map("insurance_number")

  // Relationship (for family hierarchy)
  relationship String? // HEAD_OF_HOUSEHOLD, SPOUSE, CHILD, etc.

  // Granular Permissions (replaces simple role-based access)
  permissions MemberPermissionType[] @default([VIEW_CALENDAR, VIEW_ASSETS, VIEW_MEMBERS])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household      Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user           User          @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?         @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  assignedEvents FamilyEvent[] @relation("AssignedMember")

  // Travel Concierge relation
  travelProfile TravelProfile?

  // Vehicle relation
  primaryVehicles Vehicle[] @relation("PrimaryDriver")

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

// Invitation tokens for inviting users to households
model HouseholdInvite {
  id          String        @id @default(cuid())
  householdId String        @map("household_id")
  email       String // Email address of invitee
  token       String        @unique // Secure random token for invite link
  role        HouseholdRole @default(MEMBER)
  invitedById String        @map("invited_by_id")
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@map("household_invites")
}

// ============================================================================
// REFERRALS
// ============================================================================

enum ReferralStatus {
  PENDING // Invitee hasn't signed up yet
  SIGNED_UP // Invitee created account
  CONVERTED // Invitee subscribed (reward earned)
  EXPIRED // Referral link expired
}

model Referral {
  id            String         @id @default(cuid())
  referrerId    String         @map("referrer_id") // User who referred
  referralCode  String         @unique @map("referral_code") // Unique code for this referral
  refereeEmail  String?        @map("referee_email") // Email if sent to specific person
  refereeId     String?        @map("referee_id") // User who was referred (once they sign up)
  status        ReferralStatus @default(PENDING)
  rewardEarned  Boolean        @default(false) @map("reward_earned")
  rewardAmount  Decimal?       @map("reward_amount") @db.Decimal(10, 2)
  rewardPaidAt  DateTime?      @map("reward_paid_at")
  signedUpAt    DateTime?      @map("signed_up_at")
  convertedAt   DateTime?      @map("converted_at")
  expiresAt     DateTime       @map("expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  referrer User  @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User? @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([referralCode])
  @@index([refereeEmail])
  @@map("referrals")
}

// ============================================================================
// VEHICLES
// ============================================================================

model Vehicle {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  // Basic Info
  name         String // Display name (e.g., "Bob's Tesla", "Family SUV")
  make         String // Tesla, Toyota, Honda
  model        String // Model Y, Highlander, Accord
  year         Int
  vehicleType  VehicleType @default(SUV) @map("vehicle_type")
  color        String?
  vin          String?
  licensePlate String?     @map("license_plate")

  // Ownership
  primaryDriverId String? @map("primary_driver_id")
  isOwned         Boolean @default(true) @map("is_owned") // vs leased
  isActive        Boolean @default(true) @map("is_active")

  // Tracking
  currentMileage   Int?      @map("current_mileage")
  mileageUpdatedAt DateTime? @map("mileage_updated_at")
  annualMiles      Int?      @map("annual_miles") // Estimated annual mileage

  // Registration & Insurance
  registrationExpiry DateTime? @map("registration_expiry")
  registrationState  String?   @map("registration_state")
  insuranceProvider  String?   @map("insurance_provider")
  insurancePolicyNum String?   @map("insurance_policy_num")
  insuranceExpiry    DateTime? @map("insurance_expiry")
  insuranceMonthly   Decimal?  @map("insurance_monthly") @db.Decimal(10, 2)

  // Loan/Lease Info
  hasLoan          Boolean   @default(false) @map("has_loan")
  lender           String?
  monthlyPayment   Decimal?  @map("monthly_payment") @db.Decimal(10, 2)
  loanBalance      Decimal?  @map("loan_balance") @db.Decimal(12, 2)
  loanMaturityDate DateTime? @map("loan_maturity_date")

  // Service Info
  lastOilChange        DateTime? @map("last_oil_change")
  oilChangeMileage     Int?      @map("oil_change_mileage")
  nextServiceDue       DateTime? @map("next_service_due")
  nextServiceMileage   Int?      @map("next_service_mileage")
  preferredServiceShop String?   @map("preferred_service_shop")

  // Photo
  photoUrl String? @map("photo_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household     Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  primaryDriver HouseholdMember?    @relation("PrimaryDriver", fields: [primaryDriverId], references: [id], onDelete: SetNull)
  services      VehicleService[]
  events        FamilyEvent[]
  bills         ComprehensiveBill[]

  @@index([householdId])
  @@map("vehicles")
}

model VehicleService {
  id        String @id @default(cuid())
  vehicleId String @map("vehicle_id")

  // Service Details
  serviceType VehicleServiceType @map("service_type")
  description String?
  serviceDate DateTime           @map("service_date")
  mileageAt   Int?               @map("mileage_at")

  // Cost
  cost Decimal? @db.Decimal(10, 2)

  // Provider
  shopName    String? @map("shop_name")
  shopAddress String? @map("shop_address")

  // Next Service
  nextServiceDate    DateTime? @map("next_service_date")
  nextServiceMileage Int?      @map("next_service_mileage")

  // Notes & Docs
  notes      String? @db.Text
  receiptUrl String? @map("receipt_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([serviceDate])
  @@map("vehicle_services")
}

// ============================================================================
// HOME PROFILE
// ============================================================================

model HomeProfile {
  id           String       @id @default(cuid())
  householdId  String       @unique @map("household_id")
  propertyType PropertyType @default(SINGLE_FAMILY) @map("property_type")

  // Address
  addressLine1 String  @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String
  state        String
  postalCode   String  @map("postal_code")
  country      String  @default("US")

  // Property Details
  squareFeet   Int?   @map("square_feet")
  lotSize      Float? @map("lot_size")
  yearBuilt    Int?   @map("year_built")
  bedrooms     Int?
  bathrooms    Float?
  stories      Int?
  garageSpaces Int?   @map("garage_spaces")

  // Additional Info
  purchaseDate  DateTime? @map("purchase_date")
  purchasePrice Decimal?  @map("purchase_price") @db.Decimal(12, 2)
  currentValue  Decimal?  @map("current_value") @db.Decimal(12, 2)
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("home_profiles")
}

// ============================================================================
// VENDORS & SERVICES
// ============================================================================

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Concierge routing - determines if handyman handles or routes to vendor
  tier               ServiceCategoryTier  @default(MAJOR_REPAIR)
  defaultBillingType WorkOrderBillingType @default(BILLABLE_TO_CLIENT) @map("default_billing_type")
  isHandymanEligible Boolean              @default(false) @map("is_handyman_eligible") // Can internal handyman handle this?
  estimatedMinutes   Int?                 @map("estimated_minutes") // Estimated time for scheduling

  // Relations
  vendors          Vendor[]
  serviceRequests  ServiceRequest[]
  maintenancePlans MaintenancePlan[]
  workOrders       WorkOrder[]

  @@map("service_categories")
}

model Vendor {
  id                 String         @id @default(cuid())
  householdId        String?        @map("household_id") // If set, vendor is private to this household
  displayName        String         @map("display_name")
  category           VendorCategory @default(OTHER)
  serviceDescription String?        @map("service_description")
  isLocal            Boolean        @default(true) @map("is_local")

  // Contact Info
  contactName String? @map("contact_name")
  email       String?
  phone       String?
  websiteUrl  String? @map("website_url")

  // Address
  addressLine1 String? @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String?
  state        String?
  postalCode   String? @map("postal_code")
  country      String? @default("US")

  // Business Info
  licenseNumber String? @map("license_number")
  insuranceInfo String? @map("insurance_info")
  rating        Float?  @db.Real
  reviewCount   Int     @default(0) @map("review_count")

  // Legacy field - keep for backward compatibility
  serviceCategoryId String? @map("service_category_id")
  isVerified        Boolean @default(false) @map("is_verified")
  isActive          Boolean @default(true) @map("is_active")
  notes             String?

  // Vendor portal login (links to User with VENDOR role)
  userId String? @unique @map("user_id")

  // Service areas for job board (e.g., ["Malibu", "Beverly Hills", "Pacific Palisades"])
  serviceAreas String[] @default([]) @map("service_areas")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user                User?                @relation("VendorUser", fields: [userId], references: [id], onDelete: SetNull)
  household           Household?           @relation("HouseholdVendors", fields: [householdId], references: [id], onDelete: Cascade)
  serviceCategory     ServiceCategory?     @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  householdVendors    HouseholdVendor[]
  serviceRequests     ServiceRequest[]
  messages            Message[]
  billAccounts        BillAccount[]
  maintenanceTasks    MaintenanceTask[]
  vendorPayoutAccount VendorPayoutAccount?
  workOrders          WorkOrder[]
  transactions        Transaction[]

  // Social Engine relations
  projectPosts   ProjectPost[]
  h3ServiceAreas VendorServiceArea[]

  // Project Planner relations
  vendorSuggestions VendorSuggestion[]

  // Family Assets relations
  homeSystemsServiced HomeSystem[]        @relation("SystemServiceVendor")
  homeSystemServices  HomeSystemService[] @relation("HomeSystemServiceVendor")

  // Zone-based property relations
  servicedAssets    PropertyAsset[]    @relation("AssetServiceVendor")
  serviceLogs       ServiceLog[]       @relation("ServiceLogVendor")
  propertyDocuments PropertyDocument[] @relation("DocumentVendor")

  // Comprehensive Bills
  bills ComprehensiveBill[] @relation("BillVendor")

  // Document Vault
  linkedDocuments Document[] @relation("VaultDocumentVendor")

  @@index([householdId, category])
  @@index([userId])
  @@map("vendors")
}

model HouseholdVendor {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  vendorId    String   @map("vendor_id")
  notes       String?  @db.Text
  isFavorite  Boolean  @default(false) @map("is_favorite")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // CRM Fields
  rating          Int?      // 1-5 stars (household's personal rating)
  tags            String[]  @default([]) // Custom tags
  source          String?   // "manual", "plaid", "alfred", "referral", etc.
  referredBy      String?   @map("referred_by") // Who referred this vendor
  lastContactDate DateTime? @map("last_contact_date")
  customCategory  String?   @map("custom_category") // Household's own category name

  // Relations
  household  Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendor     Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  activities VendorActivity[]
  messages   VendorMessage[]
  bills      Bill[]

  @@unique([householdId, vendorId])
  @@index([householdId, isFavorite])
  @@index([householdId, lastContactDate])
  @@map("household_vendors")
}

// Vendor CRM Activity Log - tracks all interactions with vendors
model VendorActivity {
  id                String             @id @default(cuid())
  householdVendorId String             @map("household_vendor_id")
  householdVendor   HouseholdVendor    @relation(fields: [householdVendorId], references: [id], onDelete: Cascade)

  // Activity Details
  type        VendorActivityType
  title       String
  description String? @db.Text

  // Financial
  amount Float?
  isPaid Boolean @default(false) @map("is_paid")

  // Date & Time
  date     DateTime
  duration Int?     // Duration in minutes (for calls/services)

  // Attachments/References
  invoiceUrl  String? @map("invoice_url")
  receiptUrl  String? @map("receipt_url")
  documentIds String[] @default([]) @map("document_ids") // Links to Document vault

  // Link to other entities
  maintenanceTaskId String? @map("maintenance_task_id")
  serviceRequestId  String? @map("service_request_id")

  // Metadata
  createdBy String? @map("created_by") // User who logged this

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([householdVendorId])
  @@index([householdVendorId, date])
  @@index([householdVendorId, type])
  @@map("vendor_activities")
}

// Vendor Messages - in-app messaging with vendors
model VendorMessage {
  id                String          @id @default(cuid())
  householdVendorId String          @map("household_vendor_id")
  householdVendor   HouseholdVendor @relation(fields: [householdVendorId], references: [id], onDelete: Cascade)

  direction String // "outgoing" or "incoming"
  content   String @db.Text
  status    String @default("sent") // sent, delivered, read

  createdAt DateTime @default(now()) @map("created_at")

  @@index([householdVendorId, createdAt])
  @@map("vendor_messages")
}

// ============================================================================
// SERVICE REQUESTS
// ============================================================================

model ServiceRequest {
  id                String  @id @default(cuid())
  householdId       String  @map("household_id")
  serviceCategoryId String? @map("service_category_id")
  vendorId          String? @map("vendor_id")
  createdById       String  @map("created_by_id")

  title       String
  description String
  status      ServiceRequestStatus   @default(DRAFT)
  priority    ServiceRequestPriority @default(MEDIUM)

  // Quick category for ultra-simple creation
  quickCategory RequestQuickCategory? @map("quick_category")

  // Scheduling
  preferredDate DateTime? @map("preferred_date")
  scheduledDate DateTime? @map("scheduled_date")
  completedDate DateTime? @map("completed_date")

  // Cost
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(10, 2)
  actualCost    Decimal? @map("actual_cost") @db.Decimal(10, 2)

  notes String?

  // Homeowner input tracking
  requiresHomeownerInput Boolean            @default(false) @map("requires_homeowner_input")
  inputType              HomeownerInputType @default(NONE) @map("input_type")
  inputQuestion          String?            @map("input_question") // "Which faucet style?"
  inputOptions           Json?              @map("input_options") // ["Style A", "Style B", "Style C"]
  inputResponse          String?            @map("input_response") // Homeowner's response
  inputRespondedAt       DateTime?          @map("input_responded_at")

  // Recurring detection
  similarRequestId String?   @map("similar_request_id") // Links to previous similar request
  recurringIssue   Boolean   @default(false) @map("recurring_issue")
  previousFixDate  DateTime? @map("previous_fix_date")
  previousVendorId String?   @map("previous_vendor_id")

  // Photo/voice input
  voiceTranscript String? @map("voice_transcript")
  photoUrls       Json?   @map("photo_urls") // Array of photo URLs

  // Auto-status updates tracking
  managerNote      String?   @map("manager_note") // Internal note from manager
  lastStatusUpdate String?   @map("last_status_update") // Last update message
  statusUpdatedAt  DateTime? @map("status_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("ServiceRequestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages        Message[]
  files           File[]

  @@index([householdId, status])
  @@index([vendorId, status])
  @@index([householdId, requiresHomeownerInput])
  @@map("service_requests")
}

// ============================================================================
// TASKS
// ============================================================================

model Task {
  id          String  @id @default(cuid())
  householdId String  @map("household_id")
  createdById String  @map("created_by_id")
  assigneeId  String? @map("assignee_id")

  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)

  // Scheduling
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")

  // Recurrence
  recurrence     TaskRecurrence @default(NONE)
  nextOccurrence DateTime?      @map("next_occurrence")

  // Linking
  roomName String? @map("room_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  files     File[]

  @@index([householdId, status])
  @@index([assigneeId, status])
  @@map("tasks")
}

// ============================================================================
// MAINTENANCE PLANS
// ============================================================================

model MaintenancePlan {
  id                String  @id @default(cuid())
  householdId       String  @map("household_id")
  serviceCategoryId String? @map("service_category_id")

  name        String
  description String?
  frequency   MaintenanceFrequency

  // Scheduling
  lastCompletedAt DateTime? @map("last_completed_at")
  nextDueDate     DateTime? @map("next_due_date")

  // Cost tracking
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(10, 2)

  isActive Boolean @default(true) @map("is_active")
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)

  @@index([householdId, isActive])
  @@map("maintenance_plans")
}

// ============================================================================
// MESSAGING
// ============================================================================

model Message {
  id String @id @default(cuid())

  // Channel identification - either household or service request
  channelType      ChannelType @map("channel_type")
  householdId      String?     @map("household_id")
  serviceRequestId String?     @map("service_request_id")

  senderId String? @map("sender_id")
  vendorId String? @map("vendor_id")

  content     String
  messageType MessageType @default(TEXT) @map("message_type")
  isRead      Boolean     @default(false) @map("is_read")
  readAt      DateTime?   @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household      Household?      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  sender         User?           @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  vendor         Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([channelType, householdId, createdAt])
  @@index([channelType, serviceRequestId, createdAt])
  @@map("messages")
}

// ============================================================================
// SUBSCRIPTIONS & BILLING
// ============================================================================

model Subscription {
  id     String @id @default(cuid())
  userId String @map("user_id")

  tier   SubscriptionTier   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  // Billing Period
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")

  // Payment
  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")

  cancelledAt       DateTime? @map("cancelled_at")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

model Invoice {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  invoiceNumber String        @unique @map("invoice_number")
  status        InvoiceStatus @default(DRAFT)

  // Amounts
  subtotal Decimal @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Dates
  issuedAt DateTime? @map("issued_at")
  dueDate  DateTime? @map("due_date")
  paidAt   DateTime? @map("paid_at")

  // Payment
  paymentMethod String? @map("payment_method")
  paymentRef    String? @map("payment_ref")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  files     File[]

  @@index([householdId, status])
  @@map("invoices")
}

// ============================================================================
// FILE MANAGEMENT
// ============================================================================

model File {
  id               String  @id @default(cuid())
  userId           String? @map("user_id")
  householdId      String? @map("household_id")
  serviceRequestId String? @map("service_request_id")
  taskId           String? @map("task_id")
  invoiceId        String? @map("invoice_id")

  filename     String
  originalName String       @map("original_name")
  mimeType     String       @map("mime_type")
  size         Int
  url          String? // Public URL (if applicable)
  gcsUri       String?      @map("gcs_uri") // gs://bucket/path format
  category     FileCategory @default(DOCUMENT)

  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  household      Household?      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([householdId, category])
  @@map("files")
}

// ============================================================================
// FILE ASSETS (GCS-backed uploads)
// ============================================================================

model FileAsset {
  id             String          @id @default(cuid())
  householdId    String          @map("household_id")
  uploaderUserId String          @map("uploader_user_id")
  type           FileAssetType   @default(OTHER)
  status         FileAssetStatus @default(PENDING)

  // GCS storage info
  gcsPath     String  @map("gcs_path") // e.g. "uploads/household-123/abc123.jpg"
  url         String? // Public or signed URL (updated after upload)
  filename    String // Original filename
  contentType String  @map("content_type") // MIME type
  size        Int? // File size in bytes (updated after upload)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  uploader  User      @relation("FileAssetUploader", fields: [uploaderUserId], references: [id], onDelete: Cascade)

  // Back-references (one FileAsset can only be attached to one entity)
  supportMessages     SupportMessage[]
  workOrderNotes      WorkOrderNote[]
  maintenanceTasks    MaintenanceTask[]
  transactionReceipts Transaction[]

  @@index([householdId, type])
  @@index([uploaderUserId])
  @@index([status])
  @@map("file_assets")
}

// ============================================================================
// PAYMENT METHODS
// ============================================================================

model PaymentMethod {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  stripeCustomerId      String @map("stripe_customer_id")
  stripePaymentMethodId String @map("stripe_payment_method_id")

  label    String // e.g. "Chase Checking", "Amex Blue"
  type     PaymentMethodType @default(CARD)
  last4    String
  expMonth Int?              @map("exp_month") // For cards only
  expYear  Int?              @map("exp_year") // For cards only
  bankName String?           @map("bank_name") // For bank accounts

  isDefaultForSubscription Boolean @default(false) @map("is_default_for_subscription")
  isActive                 Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  billAccounts BillAccount[]

  @@index([householdId])
  @@map("payment_methods")
}

// ============================================================================
// BILL ACCOUNTS
// ============================================================================

model BillAccount {
  id              String  @id @default(cuid())
  householdId     String  @map("household_id")
  vendorId        String  @map("vendor_id")
  paymentMethodId String? @map("payment_method_id")

  nickname      String // e.g. "Primary Mortgage", "Front Lawn Care"
  category      VendorCategory @default(OTHER)
  accountNumber String?        @map("account_number")

  // Billing Details
  billingFrequency      BillingFrequency      @default(MONTHLY) @map("billing_frequency")
  paymentResponsibility PaymentResponsibility @default(OWNER_PAYS_DIRECT) @map("payment_responsibility")
  typicalAmount         Decimal?              @map("typical_amount") @db.Decimal(10, 2)
  nextDueDate           DateTime?             @map("next_due_date")
  lastPaidDate          DateTime?             @map("last_paid_date")
  lastPaidAmount        Decimal?              @map("last_paid_amount") @db.Decimal(10, 2)

  // Vendor Autopay Settings (when paymentResponsibility = VENDOR_AUTOPAY)
  // This tracks if autopay is set up directly with the vendor
  vendorAutopayEnabled Boolean @default(false) @map("vendor_autopay_enabled")

  // Haven Pay-on-Behalf Settings (when paymentResponsibility = HAVEN_PAYS_ON_BEHALF)
  // Maximum amount Haven will auto-pay without additional approval (null = no cap)
  maxAutoPayAmount             Decimal? @map("max_auto_pay_amount") @db.Decimal(10, 2)
  // Whether Haven should automatically pay this bill
  havenAutoPayEnabled          Boolean  @default(true) @map("haven_auto_pay_enabled")
  // Whether to include in the monthly consolidated invoice (vs. pay individually)
  includeInConsolidatedInvoice Boolean  @default(true) @map("include_in_consolidated_invoice")

  // Mortgage-specific fields (only for category = MORTGAGE)
  loanBalance         Decimal?  @map("loan_balance") @db.Decimal(12, 2)
  interestRate        Decimal?  @map("interest_rate") @db.Decimal(5, 3) // e.g., 6.875%
  loanTermMonths      Int?      @map("loan_term_months") // e.g., 360 for 30-year
  loanOriginationDate DateTime? @map("loan_origination_date")
  estimatedPayoffDate DateTime? @map("estimated_payoff_date")
  escrowAmount        Decimal?  @map("escrow_amount") @db.Decimal(10, 2) // Property tax/insurance escrow
  principalAmount     Decimal?  @map("principal_amount") @db.Decimal(10, 2) // Monthly principal portion
  interestAmount      Decimal?  @map("interest_amount") @db.Decimal(10, 2) // Monthly interest portion

  // Portal & Support
  portalUrl    String? @map("portal_url")
  supportPhone String? @map("support_phone")

  notes    String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  // Relations
  household             Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendor                Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  autopayPaymentMethod  PaymentMethod?         @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  householdInvoiceItems HouseholdInvoiceItem[]
  propertyDocuments     PropertyDocument[]

  @@index([householdId, category])
  @@index([householdId, nextDueDate])
  @@index([householdId, paymentResponsibility])
  @@map("bill_accounts")
}

// ============================================================================
// MAINTENANCE TEMPLATES & TASKS
// ============================================================================

model MaintenanceTemplate {
  id          String              @id @default(cuid())
  slug        String              @unique // e.g. "hvac_tuneup", "chimney_sweep"
  title       String
  description String?
  category    MaintenanceCategory @default(GENERAL)

  // Recommended Schedule
  recommendedFrequencyMonths  Int? @map("recommended_frequency_months")
  recommendedSeasonStartMonth Int? @map("recommended_season_start_month") // 1-12
  recommendedSeasonEndMonth   Int? @map("recommended_season_end_month") // 1-12

  // Property conditions that trigger this template (stored as JSON)
  // e.g. { "has_septic": true, "has_pool": true, "climate_zone": "cold" }
  propertyConditionsJson Json? @map("property_conditions_json")

  // Default vendor category for this type of maintenance
  defaultVendorCategory VendorCategory? @map("default_vendor_category")

  // Estimated costs
  estimatedCostMin Decimal? @map("estimated_cost_min") @db.Decimal(10, 2)
  estimatedCostMax Decimal? @map("estimated_cost_max") @db.Decimal(10, 2)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  maintenanceTasks MaintenanceTask[]

  @@map("maintenance_templates")
}

model MaintenanceTask {
  id               String  @id @default(cuid())
  householdId      String  @map("household_id")
  templateId       String? @map("template_id") // Nullable if custom task
  assignedVendorId String? @map("assigned_vendor_id")
  attachmentFileId String? @map("attachment_file_id")
  completedById    String? @map("completed_by_id")
  homeSystemId     String? @map("home_system_id") // Link to specific home system

  title       String
  description String?
  category    MaintenanceCategory   @default(GENERAL)
  status      MaintenanceTaskStatus @default(PENDING)

  // Auto-generation fields
  frequency               MaintenanceFrequency? @default(ANNUAL)
  seasonalTiming          SeasonalTiming?
  source                  TaskSource            @default(MANAGER_CREATED)
  sourceSystem            String?               @map("source_system") // e.g., "HVAC", "Pool", "Roof"
  isRecurring             Boolean               @default(true) @map("is_recurring")
  recurringIntervalMonths Int?                  @map("recurring_interval_months") // For AI-generated schedules

  // Scheduling
  dueDate           DateTime? @map("due_date")
  nextDueDate       DateTime? @map("next_due_date")
  scheduledDate     DateTime? @map("scheduled_date")
  completedAt       DateTime? @map("completed_at")
  lastCompletedDate DateTime? @map("last_completed_date")

  // Cost Tracking
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(10, 2)
  actualCost    Decimal? @map("actual_cost") @db.Decimal(10, 2)

  // Template tracking
  createdFromTemplate Boolean @default(false) @map("created_from_template")

  notes           String?
  completionNotes String? @map("completion_notes")
  priority        TaskPriority @default(MEDIUM)

  // Checklist functionality
  checklistSteps      Json?   @map("checklist_steps") // Array of ChecklistStep objects
  intervalExplanation String? @map("interval_explanation") // Why this maintenance interval matters

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household      Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  template       MaintenanceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignedVendor Vendor?              @relation(fields: [assignedVendorId], references: [id], onDelete: SetNull)
  attachmentFile FileAsset?           @relation(fields: [attachmentFileId], references: [id], onDelete: SetNull)
  completedBy    User?                @relation("MaintenanceTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  homeSystem     HomeSystem?          @relation(fields: [homeSystemId], references: [id], onDelete: SetNull)
  workOrders     WorkOrder[]
  transactions   Transaction[]

  @@index([householdId, status])
  @@index([householdId, dueDate])
  @@index([householdId, nextDueDate])
  @@index([householdId, category])
  @@index([attachmentFileId])
  @@index([homeSystemId])
  @@map("maintenance_tasks")
}

// ============================================================================
// REMINDERS & NOTIFICATIONS
// ============================================================================

model Reminder {
  id          String       @id @default(cuid())
  householdId String       @map("household_id")
  type        ReminderType

  // Reference to source (one of these will be set)
  billAccountId     String? @map("bill_account_id")
  maintenanceTaskId String? @map("maintenance_task_id")
  workOrderId       String? @map("work_order_id")

  // Scheduling
  scheduledAt DateTime  @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")

  status  ReminderStatus  @default(PENDING)
  channel ReminderChannel @default(EMAIL)

  // Notification payload (stored for retry/audit)
  payloadJson Json? @map("payload_json")

  // Error tracking
  errorMessage String? @map("error_message")
  retryCount   Int     @default(0) @map("retry_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([householdId, type])
  @@index([billAccountId])
  @@index([maintenanceTaskId])
  @@index([workOrderId])
  @@map("reminders")
}

model InAppNotification {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  householdId String? @map("household_id")

  title String
  body  String

  // Action link
  link String?

  // Source reference (optional)
  billAccountId     String? @map("bill_account_id")
  maintenanceTaskId String? @map("maintenance_task_id")
  workOrderId       String? @map("work_order_id")
  reminderId        String? @map("reminder_id")

  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([householdId])
  @@map("in_app_notifications")
}

// ============================================================================
// VENDOR PAYOUT ACCOUNTS (Stripe Connect)
// ============================================================================

model VendorPayoutAccount {
  id       String @id @default(cuid())
  vendorId String @unique @map("vendor_id")

  // Stripe Connect account ID (for STRIPE_CONNECT payout method)
  // This is the connected account ID (acct_xxx) in Stripe
  stripeAccountId String? @unique @map("stripe_account_id")

  // How this vendor receives payments from Haven
  payoutMethod PayoutMethod @default(MANUAL) @map("payout_method")

  // For CHECK payouts: mailing address (could be JSON or separate fields)
  // For MANUAL: instructions or notes
  payoutDetails Json? @map("payout_details")

  // Stripe Connect onboarding status
  // STUB: In production, track onboarding completion status
  stripeOnboardingComplete Boolean @default(false) @map("stripe_onboarding_complete")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_payout_accounts")
}

// ============================================================================
// HOUSEHOLD CONSOLIDATED INVOICES
// ============================================================================

// Monthly consolidated invoice for households using HAVEN_PAYS_ON_BEHALF
model HouseholdInvoice {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  // Invoice identification
  invoiceNumber String @unique @map("invoice_number")

  // Billing period this invoice covers
  billingPeriodStart DateTime @map("billing_period_start")
  billingPeriodEnd   DateTime @map("billing_period_end")

  // Amounts
  subtotal    Decimal @db.Decimal(10, 2)
  // Platform fee (if any) - STUB for future pricing model
  platformFee Decimal @default(0) @map("platform_fee") @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  status HouseholdInvoiceStatus @default(PENDING)

  // Stripe PaymentIntent integration
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  stripePaymentStatus   String? @map("stripe_payment_status") // e.g. "succeeded", "requires_action"

  // Payment tracking
  paidAt        DateTime? @map("paid_at")
  failedAt      DateTime? @map("failed_at")
  failureReason String?   @map("failure_reason")

  // STUB: In future, link to actual vendor payouts made from this invoice
  // payoutsCompletedAt DateTime?

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household    Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items        HouseholdInvoiceItem[]
  transactions Transaction[]

  @@index([householdId, status])
  @@index([billingPeriodStart, billingPeriodEnd])
  @@map("household_invoices")
}

// Line items on a consolidated invoice (one per BillAccount included)
model HouseholdInvoiceItem {
  id                 String @id @default(cuid())
  householdInvoiceId String @map("household_invoice_id")
  billAccountId      String @map("bill_account_id")

  // Description (e.g. "Lawn Care - GreenScape Landscaping")
  description String

  // Amount for this line item (from typicalAmount or actual invoice)
  amount Decimal @db.Decimal(10, 2)

  // STUB: In future, link to actual vendor invoice/bill document
  // vendorInvoiceId String?
  // vendorInvoiceUrl String?

  // STUB: Track payout status per line item
  // payoutStatus String? // "pending", "sent", "completed"
  // payoutId String? // Reference to payout record

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  householdInvoice HouseholdInvoice @relation(fields: [householdInvoiceId], references: [id], onDelete: Cascade)
  billAccount      BillAccount      @relation(fields: [billAccountId], references: [id], onDelete: Cascade)

  @@index([householdInvoiceId])
  @@index([billAccountId])
  @@map("household_invoice_items")
}

// ============================================================================
// SUPPORT CHAT
// ============================================================================

// Support conversation between homeowner and home manager
model Conversation {
  id              String             @id @default(cuid())
  householdId     String             @map("household_id")
  createdByUserId String             @map("created_by_user_id")
  subject         String? // Optional short description like "Leaking sink"
  status          ConversationStatus @default(OPEN)

  // Unread tracking
  homeownerUnreadCount   Int @default(0) @map("homeowner_unread_count")
  homeManagerUnreadCount Int @default(0) @map("home_manager_unread_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household   Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   User                    @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]
  assignments HomeManagerAssignment[]

  @@index([householdId, status])
  @@index([status, updatedAt])
  @@map("conversations")
}

// Message within a support conversation
model SupportMessage {
  id             String     @id @default(cuid())
  conversationId String     @map("conversation_id")
  senderUserId   String?    @map("sender_user_id") // Nullable for system messages
  senderRole     SenderRole @map("sender_role")
  body           String

  // Optional attachment (image or file)
  attachmentUrl    String? @map("attachment_url")
  attachmentFileId String? @map("attachment_file_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  attachmentFile FileAsset?   @relation(fields: [attachmentFileId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([attachmentFileId])
  @@map("support_messages")
}

// Assignment of home manager to a conversation
model HomeManagerAssignment {
  id                String   @id @default(cuid())
  conversationId    String   @map("conversation_id")
  homeManagerUserId String   @map("home_manager_user_id")
  assignedAt        DateTime @default(now()) @map("assigned_at")
  assignedByUserId  String?  @map("assigned_by_user_id") // Who made the assignment

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  homeManager  User         @relation("AssignedHomeManager", fields: [homeManagerUserId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("AssignmentMadeBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([conversationId, homeManagerUserId])
  @@index([homeManagerUserId])
  @@map("home_manager_assignments")
}

// ============================================================================
// WORK ORDERS / APPOINTMENTS
// ============================================================================

// Work order for coordinating vendor visits
model WorkOrder {
  id                String  @id @default(cuid())
  householdId       String  @map("household_id")
  maintenanceTaskId String? @map("maintenance_task_id") // Optional link to maintenance task
  vendorId          String? @map("vendor_id") // External vendor (if applicable)
  handymanId        String? @map("handyman_id") // Internal handyman (for concierge tasks)
  createdByUserId   String  @map("created_by_user_id")
  serviceCategoryId String? @map("service_category_id") // For routing logic

  title       String // e.g. "Fix leaking kitchen sink"
  description String?
  status      WorkOrderStatus @default(DRAFT)

  // Concierge / Billing Type
  isConciergeRequest Boolean              @default(false) @map("is_concierge_request") // True = came from concierge request flow
  billingType        WorkOrderBillingType @default(BILLABLE_TO_CLIENT) @map("billing_type")

  // Preferred scheduling (homeowner's preference)
  preferredDate            DateTime? @map("preferred_date")
  preferredTimeWindowStart String?   @map("preferred_time_window_start") // e.g. "09:00"
  preferredTimeWindowEnd   String?   @map("preferred_time_window_end") // e.g. "12:00"

  // Actual scheduled time (set by home manager)
  scheduledStart DateTime? @map("scheduled_start")
  scheduledEnd   DateTime? @map("scheduled_end")

  // Cost tracking
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(10, 2)
  actualCost    Decimal? @map("actual_cost") @db.Decimal(10, 2) // What client pays (if billable)
  internalCost  Decimal? @map("internal_cost") @db.Decimal(10, 2) // Actual cost to company (handyman hours * rate)

  completedAt      DateTime? @map("completed_at")
  verifiedAt       DateTime? @map("verified_at")
  verifiedByUserId String?   @map("verified_by_user_id")

  // Vendor check-in/check-out tracking
  checkInAt        DateTime? @map("check_in_at")
  checkInLatitude  Float?    @map("check_in_latitude")
  checkInLongitude Float?    @map("check_in_longitude")
  checkOutAt       DateTime? @map("check_out_at")

  // Proof of completion (photo URLs/file IDs)
  proofImages String[] @default([]) @map("proof_images")

  // Service area for job board filtering (can inherit from household)
  serviceArea String? @map("service_area") // e.g., "Malibu", "Beverly Hills"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  maintenanceTask MaintenanceTask? @relation(fields: [maintenanceTaskId], references: [id], onDelete: SetNull)
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  handyman        User?            @relation("WorkOrderHandyman", fields: [handymanId], references: [id], onDelete: SetNull)
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("WorkOrderCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  verifiedBy      User?            @relation("WorkOrderVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  notes           WorkOrderNote[]
  transactions    Transaction[]

  // Social Engine relation
  projectPosts ProjectPost[]

  // Project Planner relation
  linkedProjectIdea ProjectIdea?

  // Link to inbound request that created this
  inboundRequestId String? @unique @map("inbound_request_id")

  @@index([householdId, status])
  @@index([status, scheduledStart])
  @@index([vendorId, status])
  @@index([handymanId, status])
  @@index([status, serviceArea])
  @@index([billingType, status])
  @@index([serviceCategoryId])
  @@map("work_orders")
}

// Internal notes on work orders
model WorkOrderNote {
  id               String  @id @default(cuid())
  workOrderId      String  @map("work_order_id")
  authorUserId     String  @map("author_user_id")
  body             String
  attachmentFileId String? @map("attachment_file_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  workOrder      WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author         User       @relation("WorkOrderNoteAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  attachmentFile FileAsset? @relation(fields: [attachmentFileId], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
  @@index([attachmentFileId])
  @@map("work_order_notes")
}

// ============================================================================
// FINANCIAL ENGINE - THE FLOAT
// ============================================================================

// Company wallet - Singleton record tracking Haven's business cash
// Business Model: Haven pays vendors immediately (The Float), clients reimburse monthly
model CompanyWallet {
  id String @id @default(cuid())

  // Current available balance for paying vendors
  balance Decimal @default(0) @db.Decimal(12, 2)

  // Total amount currently "floated" (paid to vendors, awaiting client reimbursement)
  outstandingFloat Decimal @default(0) @map("outstanding_float") @db.Decimal(12, 2)

  // Total amount received from clients this month
  monthlyCollections Decimal @default(0) @map("monthly_collections") @db.Decimal(12, 2)

  // Total amount paid to vendors this month
  monthlyDisbursements Decimal @default(0) @map("monthly_disbursements") @db.Decimal(12, 2)

  // Last time the monthly counters were reset
  lastResetAt DateTime @default(now()) @map("last_reset_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_wallet")
}

// Client bank account - linked to household for ACH reimbursements
model ClientBankAccount {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  // Stripe payment source info
  stripePaymentMethodId String  @map("stripe_payment_method_id")
  stripeBankAccountId   String? @map("stripe_bank_account_id")

  // Display info
  bankName     String  @map("bank_name")
  accountType  String  @map("account_type") // "checking" or "savings"
  last4        String // Last 4 digits of account number
  routingLast4 String? @map("routing_last4") // Last 4 of routing (optional)

  // Verification status
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")

  // Default payment method for this household
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("client_bank_accounts")
}

// Transaction - tracks expenses paid by Haven on behalf of clients
model Transaction {
  id          String  @id @default(cuid())
  householdId String  @map("household_id")
  vendorId    String? @map("vendor_id")
  handymanId  String? @map("handyman_id") // Internal handyman (for inclusive tasks)
  managerId   String  @map("manager_id") // Haven staff who logged/approved this

  // Transaction details
  description String
  amount      Decimal @db.Decimal(10, 2)

  // How Haven paid the vendor
  payoutMethod TransactionPayoutMethod @map("payout_method")

  // Transaction lifecycle
  status TransactionStatus @default(PENDING)

  // Reimbursement tracking
  isReimbursable Boolean @default(true) @map("is_reimbursable")

  // Inclusive expense tracking (for concierge/handyman tasks)
  isInclusiveExpense Boolean  @default(false) @map("is_inclusive_expense") // True = company absorbs cost
  handymanHours      Decimal? @map("handyman_hours") @db.Decimal(4, 2) // Hours worked
  handymanHourlyRate Decimal? @map("handyman_hourly_rate") @db.Decimal(8, 2) // Rate at time of work

  // Date tracking
  paidAt    DateTime? @map("paid_at") // When Haven paid vendor
  billedAt  DateTime? @map("billed_at") // When added to client invoice
  settledAt DateTime? @map("settled_at") // When client reimbursed Haven

  // Receipt/documentation
  receiptUrl    String? @map("receipt_url")
  receiptFileId String? @map("receipt_file_id")

  // Optional: link to work order or maintenance task
  workOrderId       String? @map("work_order_id")
  maintenanceTaskId String? @map("maintenance_task_id")

  // Invoice tracking (when billed to client)
  householdInvoiceId String? @map("household_invoice_id")

  // Due date for bill payments
  dueDate DateTime? @map("due_date")

  notes String?

  // Link to inbound request that created this
  inboundRequestId String? @unique @map("inbound_request_id")

  // Travel Concierge integration
  tripId String? @map("trip_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  handyman         User?             @relation("TransactionHandyman", fields: [handymanId], references: [id], onDelete: SetNull)
  manager          User              @relation("TransactionManager", fields: [managerId], references: [id], onDelete: Cascade)
  receiptFile      FileAsset?        @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)
  workOrder        WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  maintenanceTask  MaintenanceTask?  @relation(fields: [maintenanceTaskId], references: [id], onDelete: SetNull)
  householdInvoice HouseholdInvoice? @relation(fields: [householdInvoiceId], references: [id], onDelete: SetNull)

  // Travel Concierge relations
  trip           Trip?           @relation(fields: [tripId], references: [id], onDelete: SetNull)
  itineraryItems ItineraryItem[]

  @@index([householdId, status])
  @@index([householdId, createdAt])
  @@index([managerId])
  @@index([vendorId])
  @@index([handymanId])
  @@index([status, billedAt])
  @@index([receiptFileId])
  @@index([workOrderId])
  @@index([maintenanceTaskId])
  @@index([householdInvoiceId])
  @@index([isInclusiveExpense, householdId])
  @@index([tripId])
  @@map("transactions")
}

// ============================================================================
// SOCIAL ENGINE MODELS
// ============================================================================

// Friendship - Two-way confirmed connection (User A <-> User B)
model Friendship {
  id          String           @id @default(cuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  acceptedAt  DateTime?        @map("accepted_at")

  // Relations
  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

// Follow - One-way connection (User A follows User B)
model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  follower  User @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowedUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
  @@map("follows")
}

// ProjectPost - Shared home project linked to verified work orders
model ProjectPost {
  id          String  @id @default(cuid())
  authorId    String  @map("author_id")
  householdId String  @map("household_id")
  workOrderId String? @map("work_order_id") // Optional link to verified work
  vendorId    String? @map("vendor_id") // Vendor attribution

  title       String
  description String?

  // Before/After images (ordered array of URLs)
  beforeImages String[] @default([]) @map("before_images")
  afterImages  String[] @default([]) @map("after_images")

  // Visibility & display settings
  visibility  PostVisibility @default(PRIVATE)
  costDisplay CostDisplay    @default(HIDDEN) @map("cost_display")

  // Cached cost info (from work order or manually entered)
  actualCost   Decimal? @map("actual_cost") @db.Decimal(10, 2)
  costRangeMin Decimal? @map("cost_range_min") @db.Decimal(10, 2)
  costRangeMax Decimal? @map("cost_range_max") @db.Decimal(10, 2)

  // Project metadata
  durationDays Int?      @map("duration_days")
  completedAt  DateTime? @map("completed_at")

  // Engagement metrics (denormalized for performance)
  likesCount    Int @default(0) @map("likes_count")
  savesCount    Int @default(0) @map("saves_count")
  commentsCount Int @default(0) @map("comments_count")

  // Verification badge (if linked to verified work order)
  isVerified Boolean @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  author    User          @relation("ProjectPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  workOrder WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  vendor    Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  likes     ProjectLike[]
  saves     SavedPost[]
  comments  PostComment[]

  // Project Planner relations
  vendorSuggestions VendorSuggestion[]
  linkedProjectIdea ProjectIdea?

  @@index([authorId])
  @@index([householdId])
  @@index([vendorId])
  @@index([visibility, createdAt])
  @@index([isVerified])
  @@map("project_posts")
}

// ProjectLike - Like on a project post
model ProjectLike {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User        @relation("ProjectLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  post ProjectPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("project_likes")
}

// SavedPost - Bookmark/save a project post
model SavedPost {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User        @relation("SavedPostUser", fields: [userId], references: [id], onDelete: Cascade)
  post ProjectPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("saved_posts")
}

// PostComment - Comment on a project post
model PostComment {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  post   ProjectPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User        @relation("PostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("post_comments")
}

// VendorServiceArea - Vendors can serve multiple geographic areas (H3 cells)
model VendorServiceArea {
  id        String   @id @default(cuid())
  vendorId  String   @map("vendor_id")
  h3Index   String   @map("h3_index") // H3 Resolution 8
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, h3Index])
  @@index([h3Index])
  @@index([vendorId])
  @@map("vendor_service_areas")
}

// ============================================================================
// PROJECT PLANNER MODELS
// ============================================================================

// ProjectTemplate - Standard project definitions with cost estimation data
model ProjectTemplate {
  id          String          @id @default(cuid())
  slug        String          @unique // e.g., "deck_composite_medium"
  category    ProjectCategory
  name        String // e.g., "Medium Composite Deck"
  description String?

  // Cost estimation factors
  baseMaterialCost  Decimal  @map("base_material_cost") @db.Decimal(10, 2)
  laborHoursPerSqFt Decimal? @map("labor_hours_per_sq_ft") @db.Decimal(6, 3)
  baseLaborRate     Decimal  @default(75) @map("base_labor_rate") @db.Decimal(10, 2)

  // Complexity factors stored as JSON
  // e.g., { "multi_level": 1.3, "existing_removal": 1.15, "permits_required": 1.1 }
  complexityFactors Json? @map("complexity_factors")

  // Size ranges for estimation
  minSqFt Int? @map("min_sq_ft")
  maxSqFt Int? @map("max_sq_ft")

  // Typical duration
  estimatedDaysMin Int? @map("estimated_days_min")
  estimatedDaysMax Int? @map("estimated_days_max")

  // Reference images for inspiration
  inspirationImages String[] @default([]) @map("inspiration_images")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  projectIdeas ProjectIdea[]

  @@index([category, isActive])
  @@map("project_templates")
}

// RegionalCostIndex - H3-based regional cost multipliers
model RegionalCostIndex {
  id           String @id @default(cuid())
  h3Index      String @map("h3_index") // H3 Resolution 5 (~8km hexagons for regional coverage)
  h3Resolution Int    @default(5) @map("h3_resolution")

  // Cost multiplier (1.0 = national average)
  // SF Bay Area might be 1.8, rural Texas 0.85
  multiplier Decimal @db.Decimal(4, 2)

  // Labor rate multiplier (separate from materials)
  laborMultiplier Decimal @default(1.0) @map("labor_multiplier") @db.Decimal(4, 2)

  // Region metadata
  regionName String? @map("region_name") // e.g., "San Francisco Bay Area"
  stateCode  String? @map("state_code") // e.g., "CA"

  // Effective dates for seasonal/yearly updates
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([h3Index, effectiveFrom])
  @@index([h3Index])
  @@index([stateCode])
  @@map("regional_cost_indexes")
}

// ProjectIdea - User's project dream/plan
model ProjectIdea {
  id              String  @id @default(cuid())
  householdId     String  @map("household_id")
  createdByUserId String  @map("created_by_user_id")
  templateId      String? @map("template_id")

  // Project details
  title       String
  category    ProjectCategory
  description String?

  // Project specifications (JSON)
  // e.g., { "sqFt": 400, "material": "composite", "levels": 1 }
  specs Json?

  // "Vibe" / style preferences
  style     String? // e.g., "modern", "traditional", "rustic"
  vibeNotes String? @map("vibe_notes")

  // Mood board images (user-uploaded or saved inspiration)
  moodBoardImages String[] @default([]) @map("mood_board_images")

  // Estimated cost range (calculated by service)
  estimatedCostMin Decimal? @map("estimated_cost_min") @db.Decimal(10, 2)
  estimatedCostMax Decimal? @map("estimated_cost_max") @db.Decimal(10, 2)

  // Social proof data (cached from neighborhood analysis)
  neighborProjectCount Int     @default(0) @map("neighbor_project_count")
  socialProofNote      String? @map("social_proof_note") // "3 neighbors completed similar projects"

  // Status and lifecycle
  status ProjectIdeaStatus @default(DREAMING)

  // Timeline preferences
  targetStartDate      DateTime? @map("target_start_date")
  targetCompletionDate DateTime? @map("target_completion_date")
  urgency              String? // "no_rush", "this_year", "soon", "urgent"

  // Links to execution
  workOrderId   String? @unique @map("work_order_id")
  projectPostId String? @unique @map("project_post_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Link to inbound request that created this
  inboundRequestId String? @unique @map("inbound_request_id")

  // Relations
  household             Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy             User                   @relation("ProjectIdeaCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  template              ProjectTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  workOrder             WorkOrder?             @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  projectPost           ProjectPost?           @relation(fields: [projectPostId], references: [id], onDelete: SetNull)
  recommendationRequest RecommendationRequest?
  vendorSuggestions     VendorSuggestion[]

  @@index([householdId, status])
  @@index([status, createdAt])
  @@index([category, status])
  @@map("project_ideas")
}

// RecommendationRequest - Community Ask for vendor recommendations
model RecommendationRequest {
  id              String @id @default(cuid())
  projectIdeaId   String @unique @map("project_idea_id")
  householdId     String @map("household_id")
  createdByUserId String @map("created_by_user_id")

  // Request details
  title       String // "Looking for deck builder recommendations"
  description String?
  budget      String? // "under_5k", "5k_15k", "15k_30k", "30k_plus"
  timeline    String? // "flexible", "3_months", "this_summer"

  // Visibility (which neighbors can see this)
  h3Index  String? @map("h3_index") // User's H3 cell for neighbor matching
  isPublic Boolean @default(true) @map("is_public")

  status RecommendationRequestStatus @default(OPEN)

  // Engagement metrics
  viewCount       Int @default(0) @map("view_count")
  suggestionCount Int @default(0) @map("suggestion_count")

  expiresAt DateTime? @map("expires_at")
  closedAt  DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  projectIdea       ProjectIdea        @relation(fields: [projectIdeaId], references: [id], onDelete: Cascade)
  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("RecommendationRequestCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  vendorSuggestions VendorSuggestion[]

  @@index([h3Index, status])
  @@index([status, createdAt])
  @@map("recommendation_requests")
}

// VendorSuggestion - Neighbor or system vendor recommendation
model VendorSuggestion {
  id                      String  @id @default(cuid())
  projectIdeaId           String? @map("project_idea_id")
  recommendationRequestId String? @map("recommendation_request_id")
  vendorId                String  @map("vendor_id")
  suggestedByUserId       String? @map("suggested_by_user_id") // Null = system suggestion

  // Suggestion context
  comment String? // "They did our deck last year, great work!"
  rating  Int? // 1-5 star recommendation

  // Source tracking
  isSystemSuggestion Boolean @default(false) @map("is_system_suggestion")
  systemNote         String? @map("system_note") // "Used by 2 neighbors for similar projects"

  // Reference to suggestor's project (if applicable)
  referenceProjectPostId String? @map("reference_project_post_id")

  // Engagement
  isHelpful Boolean? @map("is_helpful") // User feedback

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  projectIdea           ProjectIdea?           @relation(fields: [projectIdeaId], references: [id], onDelete: Cascade)
  recommendationRequest RecommendationRequest? @relation(fields: [recommendationRequestId], references: [id], onDelete: Cascade)
  vendor                Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  suggestedBy           User?                  @relation("VendorSuggestionSuggestor", fields: [suggestedByUserId], references: [id], onDelete: SetNull)
  referenceProjectPost  ProjectPost?           @relation(fields: [referenceProjectPostId], references: [id], onDelete: SetNull)

  @@index([projectIdeaId])
  @@index([recommendationRequestId])
  @@index([vendorId])
  @@map("vendor_suggestions")
}

// ============================================================================
// CONCIERGE / AI TRIAGE SYSTEM
// ============================================================================

// Channel through which request was received
enum InboundChannel {
  EMAIL // Email to secretary@[household].haven.com
  SMS // Text message via Twilio
  CHAT // In-app chat with concierge
}

// AI-classified category for the request
enum RequestCategory {
  BILL // Financial obligation (invoice, bill)
  FIX // Maintenance issue (repair, fix)
  PROJECT // Renovation/improvement idea
  CALENDAR // Event/schedule item
  TRIP // Travel planning
  INQUIRY // General question
  UNKNOWN // Could not classify
}

// Status of triage processing
enum TriageStatus {
  RECEIVED // Just received, not yet processed
  PROCESSING // AI is analyzing
  PENDING_REVIEW // Needs manager review
  AUTO_APPROVED // High-confidence, auto-approved
  NEEDS_ATTENTION // Low-confidence or unknown category
  RESOLVED // Action has been taken
  REJECTED // Manager rejected
  ERROR // Processing error
}

// Priority determined by AI
enum TriagePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================================================
// TRAVEL CONCIERGE ENUMS
// ============================================================================

enum TripStatus {
  INQUIRY // User requested trip planning
  PROPOSAL_SENT // Manager sent flight/hotel options
  PENDING_SELECTION // Waiting for user to pick options
  BOOKED // All items booked
  ACTIVE // Trip in progress (departed)
  COMPLETED // Trip finished
  CANCELLED // User cancelled
}

enum ItineraryItemType {
  FLIGHT
  STAY
  CAR_RENTAL
  ACTIVITY
  TRANSFER
  OTHER
}

enum HouseProtocolStatus {
  PENDING // Not yet started
  IN_PROGRESS // Manager/Handyman working on it
  COMPLETED // All items checked
  VERIFIED // Homeowner confirmed
}

enum ProtocolItemStatus {
  PENDING
  COMPLETED
  SKIPPED
  BLOCKED // Can't complete (issue found)
}

enum SeatingPreference {
  WINDOW
  AISLE
  MIDDLE
  NO_PREFERENCE
}

// InboundRequest - Any incoming request from any channel
model InboundRequest {
  id          String  @id @default(cuid())
  householdId String? @map("household_id") // Optional - may not be identified initially
  userId      String? @map("user_id") // The user who sent it (if known)

  // Channel info
  channel    InboundChannel
  externalId String?        @map("external_id") // Email message-id, SMS sid, etc.

  // Sender info (normalized)
  senderEmail String? @map("sender_email")
  senderPhone String? @map("sender_phone")
  senderName  String? @map("sender_name")

  // Content
  subject    String?
  body       String  @db.Text
  rawPayload Json?   @map("raw_payload") // Original webhook payload

  // AI Classification
  category          RequestCategory @default(UNKNOWN)
  aiConfidence      Float?          @map("ai_confidence") // 0.0 - 1.0 confidence score
  priority          TriagePriority  @default(MEDIUM)
  summary           String? // Human-readable summary
  aiReasoning       String?         @map("ai_reasoning") @db.Text // AI's classification reasoning
  extractedEntities Json?           @map("extracted_entities") // All extracted entities as JSON

  // Triage status
  status TriageStatus @default(RECEIVED)

  // Resolution info
  resolvedAction     String?   @map("resolved_action") // PAY_BILL, CREATE_WORK_ORDER, etc.
  resolvedEntityType String?   @map("resolved_entity_type") // Transaction, WorkOrder, etc.
  resolvedEntityId   String?   @map("resolved_entity_id") // ID of created entity
  resolvedAt         DateTime? @map("resolved_at")
  resolvedByUserId   String?   @map("resolved_by_user_id")

  // Manager notes
  managerNotes String? @map("manager_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household         Household?          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user              User?               @relation("InboundRequestSender", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy        User?               @relation("InboundRequestResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  attachments       InboundAttachment[]
  suggestions       TriageSuggestion[]
  conciergeThread   ConciergeThread?    @relation(fields: [conciergeThreadId], references: [id])
  conciergeThreadId String?             @map("concierge_thread_id")

  @@index([householdId, status])
  @@index([householdId, channel])
  @@index([status, createdAt])
  @@index([category, status])
  @@map("inbound_requests")
}

// InboundAttachment - Files attached to inbound requests
model InboundAttachment {
  id               String @id @default(cuid())
  inboundRequestId String @map("inbound_request_id")

  filename    String
  contentType String  @map("content_type")
  sizeBytes   Int?    @map("size_bytes") // bytes
  storageUrl  String? @map("storage_url") // GCS or S3 URL

  // AI extraction results (for PDFs, images)
  extractedText     String? @map("extracted_text") @db.Text
  documentType      String? @map("document_type") // bill, receipt, quote, etc.
  extractedEntities Json?   @map("extracted_entities")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  inboundRequest InboundRequest @relation(fields: [inboundRequestId], references: [id], onDelete: Cascade)

  @@index([inboundRequestId])
  @@map("inbound_attachments")
}

// TriageSuggestion - AI-generated action suggestion
model TriageSuggestion {
  id               String @id @default(cuid())
  inboundRequestId String @map("inbound_request_id")

  // Suggestion details
  actionType  String // "PAY_BILL", "CREATE_WORK_ORDER", "CREATE_PROJECT", etc.
  title       String
  description String? @db.Text
  confidence  Float // 0.0 - 1.0

  // Pre-filled action data
  actionData Json @map("action_data") // Data to execute the action

  // Status
  isApproved      Boolean @default(false) @map("is_approved")
  isRejected      Boolean @default(false) @map("is_rejected")
  rejectionReason String? @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  inboundRequest InboundRequest @relation(fields: [inboundRequestId], references: [id], onDelete: Cascade)

  @@index([inboundRequestId])
  @@map("triage_suggestions")
}

// ConciergeThread - Persistent chat thread with AI concierge
model ConciergeThread {
  id          String @id @default(cuid())
  householdId String @map("household_id")
  userId      String @map("user_id")

  title    String?
  isActive Boolean @default(true) @map("is_active")

  // Context for AI
  context Json? // Conversation context, household info, etc.

  lastMessageAt DateTime? @map("last_message_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household       Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        ConciergeMessage[]
  inboundRequests InboundRequest[]

  @@unique([householdId, userId])
  @@index([householdId])
  @@index([userId])
  @@map("concierge_threads")
}

// ConciergeMessage - Individual message in chat thread
model ConciergeMessage {
  id       String @id @default(cuid())
  threadId String @map("thread_id")

  role    String // "user" or "assistant"
  content String @db.Text

  // If this message created an inbound request
  createdInboundRequestId String? @map("created_inbound_request_id")

  // AI metadata
  aiModel    String? @map("ai_model")
  tokenCount Int?    @map("token_count")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  thread ConciergeThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("concierge_messages")
}

// FamilyEvent - Calendar event for the household
model FamilyEvent {
  id              String @id @default(cuid())
  householdId     String @map("household_id")
  createdByUserId String @map("created_by_user_id")

  title       String
  description String?             @db.Text
  location    String?
  category    FamilyEventCategory @default(OTHER)

  // Assignment
  assignedToMemberId String? @map("assigned_to_member_id")

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  isAllDay  Boolean   @default(false) @map("is_all_day")

  // Recurrence
  isRecurring Boolean @default(false) @map("is_recurring")
  recurrence  String? // RRULE format

  // Reminders
  reminderMinutes Int[] @default([]) @map("reminder_minutes")

  // Color coding
  color String? // Hex color for calendar display

  // Who created this event (for "Added by Sarah" badges)
  createdByRole EventCreatorRole @default(HOMEOWNER) @map("created_by_role")
  managerNote   String?          @map("manager_note") // Note from manager when they add an event

  // Requires homeowner attention/action
  requiresAction    Boolean   @default(false) @map("requires_action")
  actionDescription String?   @map("action_description") // "Confirm access code" or "Approve pickup person"
  actionCompletedAt DateTime? @map("action_completed_at")

  // Smart reminders (manager sets up)
  reminderText   String?   @map("reminder_text") // Custom reminder message like "Emma's soccer snacks - your turn"
  reminderSentAt DateTime? @map("reminder_sent_at")

  // Conflict detection
  hasConflict        Boolean   @default(false) @map("has_conflict")
  conflictReason     String?   @map("conflict_reason") // "You'll be out of town" or "Overlaps with dentist"
  conflictResolvedAt DateTime? @map("conflict_resolved_at")

  // External calendar sync
  syncSource         CalendarSyncSource @default(MANUAL) @map("sync_source")
  externalCalendarId String?            @map("external_calendar_id")
  externalEventId    String?            @map("external_event_id")
  lastSyncedAt       DateTime?          @map("last_synced_at")

  // Link to inbound request that created this
  inboundRequestId String? @unique @map("inbound_request_id")

  // Link to related entities
  vehicleId   String? @map("vehicle_id")
  petId       String? @map("pet_id")
  workOrderId String? @map("work_order_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household  Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User             @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedTo HouseholdMember? @relation("AssignedMember", fields: [assignedToMemberId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  pet        Pet?             @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@index([householdId, startDate])
  @@index([category])
  @@index([assignedToMemberId])
  @@map("family_events")
}

// ============================================================================
// TRAVEL CONCIERGE MODELS
// ============================================================================

// TravelProfile - Secure traveler information (linked to HouseholdMember)
model TravelProfile {
  id                String @id @default(cuid())
  householdMemberId String @unique @map("household_member_id")

  // Passport Info (encrypted at rest)
  passportNumber  String?   @map("passport_number")
  passportCountry String?   @map("passport_country") // ISO country code
  passportExpiry  DateTime? @map("passport_expiry")

  // Travel Preferences
  tsaPreCheck       String?           @map("tsa_precheck") // Known Traveler Number
  globalEntry       String?           @map("global_entry")
  seatingPreference SeatingPreference @default(NO_PREFERENCE) @map("seating_preference")
  mealPreference    String?           @map("meal_preference") // Vegetarian, Kosher, etc.

  // Loyalty Programs (JSON array)
  airlineLoyalty   Json? @map("airline_loyalty") // [{ airline: "Delta", number: "123456", tier: "Gold" }]
  hotelLoyalty     Json? @map("hotel_loyalty")
  carRentalLoyalty Json? @map("car_rental_loyalty")

  // Emergency
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  householdMember HouseholdMember @relation(fields: [householdMemberId], references: [id], onDelete: Cascade)

  @@index([householdMemberId])
  @@map("travel_profiles")
}

// Trip - Travel planning entity (enhanced for full concierge workflow)
model Trip {
  id              String @id @default(cuid())
  householdId     String @map("household_id")
  createdByUserId String @map("created_by_user_id")

  // Trip Details
  title              String // "Tokyo Family Vacation"
  destination        String // "Tokyo, Japan"
  destinationCountry String? @map("destination_country") // ISO country code
  departureCity      String? @map("departure_city") // "San Francisco, CA"

  // Dates
  startDate       DateTime @map("start_date") // Departure date
  endDate         DateTime @map("end_date") // Return date
  isFlexibleDates Boolean  @default(false) @map("is_flexible_dates")

  // Budget & Preferences
  budgetMin   Decimal? @map("budget_min") @db.Decimal(10, 2)
  budgetMax   Decimal? @map("budget_max") @db.Decimal(10, 2)
  budgetNotes String?  @map("budget_notes") // "Prefer business class if under $5k"

  // Travelers
  travelerCount Int   @default(1) @map("traveler_count")
  travelers     Json? // [{ memberId: "xxx", role: "adult" }, { memberId: "yyy", role: "child" }]

  // Status
  status TripStatus @default(INQUIRY)
  notes  String?    @db.Text

  // Internal
  assignedManagerId String? @map("assigned_manager_id")

  // Totals (calculated from itinerary items)
  totalEstimatedCost Decimal? @map("total_estimated_cost") @db.Decimal(10, 2)
  totalActualCost    Decimal? @map("total_actual_cost") @db.Decimal(10, 2)

  // Link to inbound request that created this
  inboundRequestId String? @unique @map("inbound_request_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household       Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("TripCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedManager User?           @relation("TripManager", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  proposals       TripProposal[]
  itineraryItems  ItineraryItem[]
  houseProtocol   HouseProtocol?
  transactions    Transaction[]

  @@index([householdId, status])
  @@index([status, startDate])
  @@index([assignedManagerId])
  @@map("trips")
}

// TripProposal - Manager sends options for user selection
model TripProposal {
  id                 String @id @default(cuid())
  tripId             String @map("trip_id")
  createdByManagerId String @map("created_by_manager_id")

  // Proposal Content
  title       String // "Flight Options for Tokyo"
  category    ItineraryItemType // FLIGHT, STAY, etc.
  description String?           @db.Text

  // Options as JSON array
  // [{ index: 0, title: "Option A: Delta Direct", details: "...", price: 1200.00, pros: [...], cons: [...] }]
  options Json

  // User Selection
  selectedOptionIndex Int?      @map("selected_option_index")
  selectedAt          DateTime? @map("selected_at")

  // Status
  sentAt    DateTime? @map("sent_at") // When proposal was sent to user
  expiresAt DateTime? @map("expires_at") // Options expire

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  trip             Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdByManager User @relation("TripProposalCreator", fields: [createdByManagerId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([createdByManagerId])
  @@map("trip_proposals")
}

// ItineraryItem - Actual booked travel assets
model ItineraryItem {
  id     String @id @default(cuid())
  tripId String @map("trip_id")

  // Item Details
  type        ItineraryItemType
  title       String // "Delta Flight DL123"
  description String?           @db.Text

  // Timing
  startDateTime DateTime  @map("start_date_time") // Departure/Check-in
  endDateTime   DateTime? @map("end_date_time") // Arrival/Check-out
  timezone      String? // "America/Los_Angeles"

  // Location
  startLocation String? @map("start_location") // "SFO Terminal 2"
  endLocation   String? @map("end_location") // "NRT Terminal 1"

  // Booking Details
  confirmationNumber String? @map("confirmation_number")
  bookingReference   String? @map("booking_reference") // URL or reference
  providerName       String? @map("provider_name") // "Delta Airlines", "Marriott"

  // Cost (feeds into financial engine)
  cost          Decimal @db.Decimal(10, 2)
  currency      String  @default("USD")
  paidByHaven   Boolean @default(true) @map("paid_by_haven")
  transactionId String? @map("transaction_id") // Link to Transaction for reimbursement

  // Documents (PDF tickets, vouchers)
  documents Json? // [{ name: "Boarding Pass", fileAssetId: "xxx", url: "..." }]

  // Display order
  sortOrder Int @default(0) @map("sort_order")

  // Notes
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([tripId, startDateTime])
  @@index([transactionId])
  @@map("itinerary_items")
}

// HouseProtocol - Vacation mode checklist
model HouseProtocol {
  id          String @id @default(cuid())
  tripId      String @unique @map("trip_id")
  householdId String @map("household_id")

  // Assignment
  assignedToUserId String? @map("assigned_to_user_id") // Manager or Handyman

  // Timing
  scheduledDate    DateTime  @map("scheduled_date") // Usually 24h before trip start
  completedAt      DateTime? @map("completed_at")
  verifiedAt       DateTime? @map("verified_at")
  verifiedByUserId String?   @map("verified_by_user_id")

  // Status
  status HouseProtocolStatus @default(PENDING)

  // Notes
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  trip       Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  household  Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignedTo User?               @relation("ProtocolAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  items      HouseProtocolItem[]

  @@index([householdId, status])
  @@index([assignedToUserId])
  @@index([scheduledDate])
  @@map("house_protocols")
}

// HouseProtocolItem - Individual checklist items
model HouseProtocolItem {
  id         String @id @default(cuid())
  protocolId String @map("protocol_id")

  // Item Details
  title       String // "Shut off water main"
  description String? // "Valve is in basement near water heater"
  category    String? // "Water", "Security", "HVAC", "Mail"

  // Status
  status            ProtocolItemStatus @default(PENDING)
  completedAt       DateTime?          @map("completed_at")
  completedByUserId String?            @map("completed_by_user_id")

  // Proof
  proofPhotoUrl    String? @map("proof_photo_url") // Photo of valve in OFF position
  proofFileAssetId String? @map("proof_file_asset_id")
  proofNotes       String? @map("proof_notes")

  // Order
  sortOrder  Int     @default(0) @map("sort_order")
  isRequired Boolean @default(true) @map("is_required")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  protocol    HouseProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  completedBy User?         @relation("ProtocolItemCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([protocolId])
  @@map("house_protocol_items")
}

// ============================================================================
// FAMILY ASSETS - PETS, HOME SYSTEMS (Vehicles defined above)
// ============================================================================

// Pet - Household pets
model Pet {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  // Basic Info
  name         String
  type         PetType   @default(DOG)
  breed        String?
  color        String?
  size         PetSize?
  weight       Decimal?  @db.Decimal(6, 2) // in pounds
  birthday     DateTime? @db.Date
  adoptionDate DateTime? @map("adoption_date") @db.Date
  gender       String? // Male, Female, Unknown

  // Identification
  microchipId     String?   @map("microchip_id")
  registrationNum String?   @map("registration_num")
  licenseNum      String?   @map("license_num")
  licenseExpires  DateTime? @map("license_expires")

  // Health
  isSpayedNeutered Boolean  @default(false) @map("is_spayed_neutered")
  allergies        String[] @default([])
  medications      String[] @default([]) // Current medications
  specialNeeds     String?  @map("special_needs") @db.Text

  // Veterinary Care
  vetClinicName    String? @map("vet_clinic_name")
  vetClinicPhone   String? @map("vet_clinic_phone")
  vetClinicAddress String? @map("vet_clinic_address")
  vetClinicEmail   String? @map("vet_clinic_email")
  primaryVetName   String? @map("primary_vet_name")

  // Insurance
  insuranceProvider  String?   @map("insurance_provider")
  insurancePolicyNum String?   @map("insurance_policy_num")
  insuranceExpires   DateTime? @map("insurance_expires")

  // Food & Diet
  foodBrand       String? @map("food_brand")
  foodType        String? @map("food_type") // Dry, Wet, Raw, etc.
  feedingSchedule String? @map("feeding_schedule")
  dietaryNotes    String? @map("dietary_notes") @db.Text

  // Care Instructions (for pet sitters)
  careInstructions String? @map("care_instructions") @db.Text
  emergencyContact String? @map("emergency_contact")
  behavioralNotes  String? @map("behavioral_notes") @db.Text

  // Photos
  photoUrls String[] @default([]) @map("photo_urls")

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household  Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vetRecords PetVetRecord[]
  events     FamilyEvent[]

  @@index([householdId])
  @@map("pets")
}

// Pet Veterinary Records - Health history
model PetVetRecord {
  id    String @id @default(cuid())
  petId String @map("pet_id")

  visitDate   DateTime @map("visit_date")
  visitType   String   @map("visit_type") // Checkup, Vaccination, Emergency, Surgery, Grooming
  description String?  @db.Text
  diagnosis   String?  @db.Text
  treatment   String?  @db.Text
  weight      Decimal? @db.Decimal(6, 2)

  // Vaccinations
  vaccinationsGiven   String[]  @default([]) @map("vaccinations_given")
  nextVaccinationDate DateTime? @map("next_vaccination_date")

  // Medications prescribed
  prescriptions Json? // { name, dosage, frequency, startDate, endDate }

  // Cost
  cost      Decimal? @db.Decimal(10, 2)
  vetClinic String?  @map("vet_clinic")
  vetName   String?  @map("vet_name")

  // Documents
  documentUrls String[] @default([]) @map("document_urls")

  // Follow-up
  followUpDate  DateTime? @map("follow_up_date")
  followUpNotes String?   @map("follow_up_notes") @db.Text

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, visitDate])
  @@map("pet_vet_records")
}

// HomeSystem - Detailed tracking of home systems & appliances
model HomeSystem {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  // Identification
  name     String // "Main Furnace", "Kitchen Refrigerator"
  type     HomeSystemType
  location String? // "Basement", "Kitchen", "Master Bathroom"

  // Product Info
  brand        String?
  model        String?
  modelNumber  String? @map("model_number")
  serialNumber String? @map("serial_number")
  color        String?

  // Purchase/Installation
  purchaseDate  DateTime? @map("purchase_date")
  purchasePrice Decimal?  @map("purchase_price") @db.Decimal(10, 2)
  purchasedFrom String?   @map("purchased_from")
  installedDate DateTime? @map("installed_date")
  installedBy   String?   @map("installed_by") // Vendor name

  // Warranty
  warrantyExpires         DateTime? @map("warranty_expires")
  warrantyProvider        String?   @map("warranty_provider")
  warrantyPhone           String?   @map("warranty_phone")
  warrantyDetails         String?   @map("warranty_details") @db.Text
  extendedWarranty        Boolean   @default(false) @map("extended_warranty")
  extendedWarrantyExpires DateTime? @map("extended_warranty_expires")

  // Condition
  condition         ApplianceCondition @default(GOOD)
  lastInspectedDate DateTime?          @map("last_inspected_date")

  // Maintenance Schedule
  maintenanceIntervalMonths Int?      @map("maintenance_interval_months")
  lastMaintenanceDate       DateTime? @map("last_maintenance_date")
  nextMaintenanceDate       DateTime? @map("next_maintenance_date")
  maintenanceNotes          String?   @map("maintenance_notes") @db.Text

  // Service Info (for utilities like heating oil, propane)
  serviceProvider      String?   @map("service_provider")
  serviceAccountNumber String?   @map("service_account_number")
  servicePhone         String?   @map("service_phone")
  lastServiceDate      DateTime? @map("last_service_date")
  currentRate          Decimal?  @map("current_rate") @db.Decimal(10, 4) // e.g., $/kWh or $/gallon
  rateUnit             String?   @map("rate_unit") // kWh, gallon, therm, etc.
  lastBillAmount       Decimal?  @map("last_bill_amount") @db.Decimal(10, 2)
  lastBillDate         DateTime? @map("last_bill_date")
  averageMonthlyUsage  Decimal?  @map("average_monthly_usage") @db.Decimal(10, 2)
  usageUnit            String?   @map("usage_unit")

  // For fuel-based systems (oil, propane)
  tankCapacity       Decimal?  @map("tank_capacity") @db.Decimal(10, 2)
  lastFillDate       DateTime? @map("last_fill_date")
  lastFillAmount     Decimal?  @map("last_fill_amount") @db.Decimal(10, 2)
  estimatedRemaining Decimal?  @map("estimated_remaining") @db.Decimal(10, 2)

  // Documents
  manualUrl      String?  @map("manual_url")
  receiptUrl     String?  @map("receipt_url")
  warrantyDocUrl String?  @map("warranty_doc_url")
  photoUrls      String[] @default([]) @map("photo_urls")

  // Energy efficiency
  energyRating    String?  @map("energy_rating") // ENERGY STAR, etc.
  efficiencyScore Decimal? @map("efficiency_score") @db.Decimal(4, 2)

  // Filter info (for HVAC systems)
  filterSize                 String?   @map("filter_size")
  filterType                 String?   @map("filter_type") // HEPA, MERV 8, etc.
  lastFilterChange           DateTime? @map("last_filter_change")
  filterChangeIntervalMonths Int?      @default(3) @map("filter_change_interval_months")

  // Link to related vendor
  serviceVendorId String? @map("service_vendor_id")

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household        Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  serviceVendor    Vendor?             @relation("SystemServiceVendor", fields: [serviceVendorId], references: [id], onDelete: SetNull)
  serviceHistory   HomeSystemService[]
  maintenanceTasks MaintenanceTask[]

  @@index([householdId, type])
  @@index([nextMaintenanceDate])
  @@map("home_systems")
}

// HomeSystemService - Service history for home systems
model HomeSystemService {
  id           String @id @default(cuid())
  homeSystemId String @map("home_system_id")

  serviceDate    DateTime @map("service_date")
  serviceType    String   @map("service_type") // Inspection, Repair, Maintenance, Replacement
  description    String?  @db.Text
  technicianName String?  @map("technician_name")

  // Parts replaced
  partsReplaced String[] @default([]) @map("parts_replaced")

  // Cost
  laborCost Decimal? @map("labor_cost") @db.Decimal(10, 2)
  partsCost Decimal? @map("parts_cost") @db.Decimal(10, 2)
  totalCost Decimal? @map("total_cost") @db.Decimal(10, 2)

  // Vendor
  vendorId   String? @map("vendor_id")
  vendorName String? @map("vendor_name")

  // Documents
  invoiceUrl String? @map("invoice_url")
  receiptUrl String? @map("receipt_url")
  reportUrl  String? @map("report_url")

  // Next service
  nextServiceDate DateTime? @map("next_service_date")
  recommendations String?   @db.Text

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  homeSystem HomeSystem @relation(fields: [homeSystemId], references: [id], onDelete: Cascade)
  vendor     Vendor?    @relation("HomeSystemServiceVendor", fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([homeSystemId, serviceDate])
  @@map("home_system_services")
}

// HomeChecklist - Smart intake checklist generated from ATTOM property data
// Used by Home Managers to gather comprehensive info during intro calls
model HomeChecklist {
  id          String @id @default(cuid())
  householdId String @unique @map("household_id")

  // Checklist items (JSON array of ChecklistItem)
  // Each item has: id, category, priority, question, context, dataField, inputType, options, answered, answer
  items Json

  // Summary stats (denormalized for quick access)
  totalItems            Int @default(0) @map("total_items")
  completedItems        Int @default(0) @map("completed_items")
  highPriorityRemaining Int @default(0) @map("high_priority_remaining")

  // Status
  status      String    @default("pending") // pending, in_progress, completed
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Who completed it
  completedByUserId String? @map("completed_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  completedBy User?     @relation("ChecklistCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@map("home_checklists")
}

// ============================================================================
// HOUSEHOLD INTAKE - Comprehensive Onboarding Workbench
// ============================================================================

// Status of the intake process
enum IntakeStatus {
  PENDING // Not started
  SCHEDULED // Call scheduled
  IN_PROGRESS // Currently on call
  PAUSED // Partially completed, will resume
  COMPLETED // All sections done
  ARCHIVED // Intake archived
}

// Family member types (NOT pets - use Pet model for pets)
enum FamilyMemberType {
  ADULT // Adult household member (spouse, partner, parent)
  CHILD // Child in household
  STAFF // Household staff (nanny, housekeeper, caretaker)
}

// HouseholdIntake - Main intake session record for Home Manager calls
model HouseholdIntake {
  id          String @id @default(cuid())
  householdId String @unique @map("household_id")

  // Status tracking (using OnboardingStatus for full lifecycle)
  status   OnboardingStatus @default(PENDING_CALL)
  progress Int              @default(0) // 0-100 percentage

  // User's initial input from signup
  biggestChallenge String? @map("biggest_challenge")
  selectedTier     String? @map("selected_tier")

  // Scheduling
  scheduledAt DateTime? @map("scheduled_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Manager handling the intake
  managerId String? @map("manager_id")

  // Section completion tracking (JSON object mapping section ids to completion status)
  sectionsCompleted Json? @map("sections_completed")

  // Intake progress by section (0-100 each)
  progressFamily   Int @default(0) @map("progress_family")
  progressProperty Int @default(0) @map("progress_property")
  progressZones    Int @default(0) @map("progress_zones")
  progressSystems  Int @default(0) @map("progress_systems")
  progressVendors  Int @default(0) @map("progress_vendors")
  progressBills    Int @default(0) @map("progress_bills")

  // Flexible data during intake
  intakeData Json? @map("intake_data")

  // Call notes and observations
  callNotes    String? @map("call_notes") @db.Text
  managerNotes String? @map("manager_notes") @db.Text

  // Calculated monthly funding recommendation
  calculatedMonthlyFunding Decimal? @map("calculated_monthly_funding") @db.Decimal(10, 2)
  fundingBreakdown         Json?    @map("funding_breakdown")

  // Next steps and follow-ups
  nextSteps      String?   @map("next_steps") @db.Text
  followUpDate   DateTime? @map("follow_up_date")
  followUpNeeded Boolean   @default(false) @map("follow_up_needed")
  followUpNotes  String?   @map("follow_up_notes") @db.Text

  // Milestones
  profileDeliveredAt DateTime? @map("profile_delivered_at")
  firstBillPaidAt    DateTime? @map("first_bill_paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  manager   User?     @relation("IntakeManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@map("household_intakes")
}

// FamilyMember - Non-user household members (adults, children, staff)
// Note: Pets should use the Pet model, not FamilyMember
model FamilyMember {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  // Basic Info
  firstName String           @map("first_name")
  lastName  String?          @map("last_name")
  nickname  String?
  type      FamilyMemberType @default(ADULT)

  // Contact (for adults/staff)
  email String?
  phone String?

  // Demographics
  birthdate    DateTime? @db.Date
  relationship String? // e.g., "Spouse", "Son", "Daughter", "Nanny", "Housekeeper"

  // School/Work info (for children)
  school        String?
  schoolGrade   String? @map("school_grade")
  teacher       String?
  schoolPickup  String? @map("school_pickup") // "Bus", "Parent", "Carpool", etc.
  schoolDropoff String? @map("school_dropoff")

  // Staff info
  workSchedule     String?   @map("work_schedule") // e.g., "M-F 8am-6pm"
  responsibilities String?   @db.Text
  startDate        DateTime? @map("start_date") @db.Date
  paymentMethod    String?   @map("payment_method") // For staff pay tracking

  // Medical (optional for emergency)
  allergies    String[] @default([])
  medications  String[] @default([])
  specialNeeds String?  @map("special_needs") @db.Text
  bloodType    String?  @map("blood_type")
  medicalNotes String?  @map("medical_notes") @db.Text

  // Medical Providers
  primaryDoctorName    String? @map("primary_doctor_name")
  primaryDoctorPhone   String? @map("primary_doctor_phone")
  primaryDoctorAddress String? @map("primary_doctor_address")
  dentistName          String? @map("dentist_name")
  dentistPhone         String? @map("dentist_phone")
  dentistAddress       String? @map("dentist_address")

  // Work info (for adults)
  occupation   String?
  employer     String?
  workPhone    String? @map("work_phone")
  workAddress  String? @map("work_address")

  // Emergency contacts
  emergencyContact      String? @map("emergency_contact")
  emergencyContactPhone String? @map("emergency_contact_phone")

  // Photo
  photoUrl String? @map("photo_url")

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household     Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  activities    FamilyActivity[]
  bills         ComprehensiveBill[]
  kidActivities KidActivity[]

  @@index([householdId, type])
  @@map("family_members")
}

// Membership - Club memberships, gym memberships, country clubs, etc.
model Membership {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  // Basic Info
  name         String  // e.g., "Greenwich Country Club", "Equinox"
  type         String  // "country-club", "gym", "pool", "club", "other"
  memberName   String? @map("member_name") // Primary member on the account
  memberNumber String? @map("member_number")

  // Costs
  monthlyCost Float? @map("monthly_cost")
  annualCost  Float? @map("annual_cost")

  // Contact & Location
  contactPhone  String? @map("contact_phone")
  contactEmail  String? @map("contact_email")
  address       String?
  website       String?

  // Dates
  renewalDate DateTime? @map("renewal_date") @db.Date
  startDate   DateTime? @map("start_date") @db.Date

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("memberships")
}

// FamilyActivity - Recurring activities and subscriptions for family members
model FamilyActivity {
  id             String  @id @default(cuid())
  householdId    String  @map("household_id")
  familyMemberId String? @map("family_member_id")

  // Activity details
  name        String // e.g., "Soccer Practice", "Piano Lessons"
  category    String // Sports, Music, Art, Tutoring, Camp, etc.
  description String? @db.Text
  location    String?

  // Schedule
  schedule   String? // e.g., "Tuesdays and Thursdays 4-5pm"
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  isSeasonal Boolean   @default(false) @map("is_seasonal")
  season     String? // "Fall", "Spring", "Summer", "Year-round"

  // Organization/Provider
  organizationName String? @map("organization_name")
  contactName      String? @map("contact_name")
  contactPhone     String? @map("contact_phone")
  contactEmail     String? @map("contact_email")
  websiteUrl       String? @map("website_url")

  // Cost
  costAmount    Decimal?          @map("cost_amount") @db.Decimal(10, 2)
  costFrequency BillingFrequency? @map("cost_frequency")
  paymentMethod String?           @map("payment_method")
  paymentDueDay Int?              @map("payment_due_day") // Day of month

  // Equipment/supplies needed
  equipmentNeeded String[] @default([]) @map("equipment_needed")

  // Transportation
  transportation String? // "Parent drives", "Carpool", "Walk", etc.

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([familyMemberId])
  @@map("family_activities")
}

// ============================================================================
// ZONE-BASED PROPERTY STRUCTURE (Nines-style)
// ============================================================================

enum ZoneType {
  KITCHEN
  LIVING_ROOM
  DINING_ROOM
  BEDROOM
  BATHROOM
  GARAGE
  BASEMENT
  ATTIC
  LAUNDRY
  OFFICE
  MUDROOM
  PANTRY
  OUTDOOR_FRONT
  OUTDOOR_BACK
  POOL_AREA
  MECHANICAL
  OTHER
}

enum AssetCategory {
  APPLIANCE
  HVAC
  PLUMBING
  ELECTRICAL
  STRUCTURAL
  FURNITURE
  ELECTRONICS
  OUTDOOR
  VEHICLE
  SAFETY
  OTHER
}

enum ServiceLogType {
  MAINTENANCE
  REPAIR
  REPLACEMENT
  INSPECTION
  INSTALLATION
  CLEANING
  OTHER
}

enum DocumentType {
  CONTRACT
  WARRANTY
  MANUAL
  RECEIPT
  INVOICE
  INSURANCE
  TAX
  PHOTO
  OTHER
}

enum OnboardingStatus {
  PENDING_CALL // Just signed up, waiting for call (same as SIGNUP_COMPLETE)
  SIGNUP_COMPLETE // Legacy: Just signed up
  CALL_SCHEDULED // Intro call scheduled
  CALL_IN_PROGRESS // Currently on call
  INTAKE_PARTIAL // Call done but need follow-up
  INTAKE_COMPLETE // All data captured
  PROFILE_BUILDING // HM building profile
  PROFILE_DELIVERED // Sent to homeowner
  ACTIVE // Fully onboarded
}

// ============================================================================
// COMPREHENSIVE BILLS & ACCOUNTS
// ============================================================================

enum BillCategory {
  // Housing
  MORTGAGE
  RENT
  PROPERTY_TAX
  HOA
  HOME_INSURANCE

  // Utilities
  ELECTRIC
  GAS
  WATER_SEWER
  OIL_PROPANE
  TRASH

  // Telecom
  INTERNET
  CABLE_TV
  CELL_PHONE
  LANDLINE

  // Vehicles
  CAR_PAYMENT
  AUTO_INSURANCE
  CAR_REGISTRATION
  PARKING
  TOLLS

  // Family & Kids
  SCHOOL_TUITION
  CHILDCARE
  NANNY
  KIDS_ACTIVITY
  SCHOOL_LUNCH
  TUTORING

  // Loans & Debt
  STUDENT_LOAN
  PERSONAL_LOAN
  HELOC
  CREDIT_CARD

  // Insurance
  LIFE_INSURANCE
  HEALTH_INSURANCE
  UMBRELLA_INSURANCE
  PET_INSURANCE
  DISABILITY_INSURANCE
  LONG_TERM_CARE

  // Home Services
  LAWN_LANDSCAPE
  POOL_SERVICE
  PEST_CONTROL
  SECURITY_MONITORING
  HOUSE_CLEANING
  SNOW_REMOVAL

  // Memberships & Subscriptions
  GYM_FITNESS
  CLUB_MEMBERSHIP
  STREAMING_SERVICE
  SOFTWARE_SUBSCRIPTION
  NEWSPAPER_MAGAZINE
  MEAL_KIT
  AMAZON_PRIME
  WAREHOUSE_CLUB

  // Other
  STORAGE
  PET_CARE
  CHARITY_DONATION
  CHILD_SUPPORT
  ALIMONY
  OTHER_BILL
}

enum PayeeType {
  COMPANY
  INDIVIDUAL
  GOVERNMENT
  SCHOOL
  ORGANIZATION
}

enum AmountType {
  FIXED // Same every time
  VARIABLE // Changes (like electric)
  ESTIMATED // Best guess
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  TWICE_MONTHLY // 1st and 15th
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  ONE_TIME
  AS_NEEDED // Like oil delivery
}

enum BillPaymentMethod {
  HAVEN_PAYS // Haven will pay this
  OWNER_AUTOPAY // Owner keeps their autopay
  OWNER_MANUAL // Owner pays manually
  PAYROLL // Deducted from paycheck
  ESCROW // Included in mortgage
}

enum BillStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAID_OFF // For loans
  PENDING_SETUP // Haven taking over
}

enum ActivityType {
  SPORTS
  MUSIC
  ARTS
  ACADEMIC
  RELIGIOUS
  SOCIAL
  CAMP
  OTHER_ACTIVITY
}

// ComprehensiveBill - Every recurring payment a household makes
model ComprehensiveBill {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  // Categorization
  category    BillCategory
  subcategory String?

  // What is this bill for?
  name        String // "Eversource Electric", "Toyota Financial - Model Y"
  description String? @db.Text

  // Who do we pay?
  payeeName String?   @map("payee_name")
  payeeType PayeeType @default(COMPANY) @map("payee_type")

  // Account Information (CRITICAL for Haven to pay)
  accountNumber String? @map("account_number")
  accountName   String? @map("account_name") // Name on account if different
  policyNumber  String? @map("policy_number") // For insurance
  memberNumber  String? @map("member_number") // For memberships
  studentId     String? @map("student_id") // For school payments

  // Login/Portal Access (for Haven to manage)
  portalUrl      String? @map("portal_url")
  portalUsername String? @map("portal_username")
  portalNotes    String? @map("portal_notes") @db.Text // "Password in 1Password"

  // Payment Details
  amount     Decimal          @db.Decimal(10, 2)
  amountType AmountType       @default(FIXED) @map("amount_type")
  frequency  PaymentFrequency
  dueDay     Int?             @map("due_day") // Day of month (1-31)
  dueDate    DateTime?        @map("due_date") // For non-monthly

  // Payment Method
  paymentMethod  BillPaymentMethod @default(HAVEN_PAYS) @map("payment_method")
  currentAutopay Boolean           @default(false) @map("current_autopay")
  autopayAccount String?           @map("autopay_account") // Which account is it autopaying from?

  // For Loans/Mortgages
  isLoan           Boolean   @default(false) @map("is_loan")
  principalBalance Decimal?  @map("principal_balance") @db.Decimal(12, 2)
  interestRate     Decimal?  @map("interest_rate") @db.Decimal(5, 3) // e.g., 6.875%
  loanTerm         String?   @map("loan_term") // "30 years", "5 years"
  maturityDate     DateTime? @map("maturity_date")
  escrowIncluded   Boolean?  @map("escrow_included") // For mortgage - includes taxes/insurance?

  // For Insurance
  isInsurance    Boolean   @default(false) @map("is_insurance")
  coverageAmount Decimal?  @map("coverage_amount") @db.Decimal(12, 2)
  deductible     Decimal?  @map("deductible") @db.Decimal(10, 2)
  renewalDate    DateTime? @map("renewal_date")

  // Linked Items
  vendorId       String? @map("vendor_id")
  vehicleId      String? @map("vehicle_id") // For car payments/insurance
  familyMemberId String? @map("family_member_id") // For kid-specific bills
  assetId        String? @map("asset_id") // For equipment warranties

  // Status
  status         BillStatus @default(ACTIVE)
  havenManaged   Boolean    @default(false) @map("haven_managed")
  havenStartDate DateTime?  @map("haven_start_date")

  // Verification
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")
  verifiedBy String?   @map("verified_by")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household    Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendor       Vendor?             @relation("BillVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  familyMember FamilyMember?       @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  asset        PropertyAsset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  payments     BillPaymentRecord[]

  @@index([householdId, category])
  @@index([householdId, status])
  @@index([vendorId])
  @@map("comprehensive_bills")
}

// BillPaymentRecord - History of payments made
model BillPaymentRecord {
  id                  String @id @default(cuid())
  comprehensiveBillId String @map("comprehensive_bill_id")

  amount             Decimal  @db.Decimal(10, 2)
  paidDate           DateTime @map("paid_date")
  paidBy             String   @map("paid_by") // "Haven", "Owner", etc.
  method             String? // "Virtual Card", "ACH", etc.
  confirmationNumber String?  @map("confirmation_number")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  bill ComprehensiveBill @relation(fields: [comprehensiveBillId], references: [id], onDelete: Cascade)

  @@index([comprehensiveBillId, paidDate])
  @@map("bill_payment_records")
}

// KidActivity - Detailed tracking of children's activities
model KidActivity {
  id             String @id @default(cuid())
  familyMemberId String @map("family_member_id")
  householdId    String @map("household_id")

  name String // "Soccer", "Piano Lessons"
  type ActivityType

  // Organization
  organization String?
  location     String?

  // Schedule
  schedule    String? // "Tuesdays 4-5pm"
  seasonStart DateTime? @map("season_start")
  seasonEnd   DateTime? @map("season_end")

  // Cost
  cost            Decimal?          @db.Decimal(10, 2)
  costFrequency   PaymentFrequency? @map("cost_frequency")
  registrationFee Decimal?          @map("registration_fee") @db.Decimal(10, 2)
  equipmentCost   Decimal?          @map("equipment_cost") @db.Decimal(10, 2)

  // Contact
  coachName    String? @map("coach_name")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  // Payment
  paymentMethod String? @map("payment_method")
  accountNumber String? @map("account_number")
  portalUrl     String? @map("portal_url")

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([familyMemberId])
  @@map("kid_activities")
}

// Zone - A distinct area of the property (Kitchen, Master Bath, Garage, etc.)
model Zone {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  name  String // "Kitchen", "Master Bathroom", "Garage", etc.
  type  ZoneType
  floor String? // "1st Floor", "Basement", etc.

  // Photos
  photos String[] @default([])

  // Notes and procedures for this zone
  notes      String? @db.Text
  procedures String? @db.Text // How to care for this zone

  // Sort order for display
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assets      PropertyAsset[]
  serviceLogs ServiceLog[]

  @@index([householdId, type])
  @@map("zones")
}

// PropertyAsset - An appliance, system, or item in the home
model PropertyAsset {
  id          String  @id @default(cuid())
  householdId String  @map("household_id")
  zoneId      String? @map("zone_id")

  name     String // "Refrigerator", "Furnace", "Washer"
  category AssetCategory

  // Details
  brand        String?
  model        String?
  serialNumber String? @map("serial_number")
  color        String?

  // Purchase/Warranty
  purchaseDate    DateTime? @map("purchase_date")
  purchasePrice   Decimal?  @map("purchase_price") @db.Decimal(10, 2)
  purchaseVendor  String?   @map("purchase_vendor")
  warrantyExpires DateTime? @map("warranty_expires")
  warrantyNotes   String?   @map("warranty_notes") @db.Text

  // Condition
  condition      String? // "Excellent", "Good", "Fair", "Needs Service"
  conditionNotes String? @map("condition_notes") @db.Text

  // Service
  serviceVendorId String?   @map("service_vendor_id")
  lastServiceDate DateTime? @map("last_service_date")
  nextServiceDate DateTime? @map("next_service_date")
  serviceInterval String?   @map("service_interval") // "annual", "6 months", etc.

  // Documents/Photos
  photos    String[] @default([])
  manualUrl String?  @map("manual_url")

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household     Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  zone          Zone?               @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  serviceVendor Vendor?             @relation("AssetServiceVendor", fields: [serviceVendorId], references: [id], onDelete: SetNull)
  serviceLogs   ServiceLog[]
  documents     PropertyDocument[]
  bills         ComprehensiveBill[]

  @@index([householdId, category])
  @@index([zoneId])
  @@map("property_assets")
}

// ServiceLog - History of all service/maintenance performed
model ServiceLog {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  // Can be linked to asset, zone, or just property
  assetId String? @map("asset_id")
  zoneId  String? @map("zone_id")

  // What happened
  type        ServiceLogType
  title       String
  description String?        @db.Text

  // Who did it
  vendorId    String? @map("vendor_id")
  performedBy String? @map("performed_by") // Name if not a vendor

  // When
  serviceDate DateTime @map("service_date")

  // Cost
  cost       Decimal? @db.Decimal(10, 2)
  invoiceUrl String?  @map("invoice_url")

  // Photos/Documents
  photos String[] @default([])

  // Notes
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  asset     PropertyAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  zone      Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  vendor    Vendor?        @relation("ServiceLogVendor", fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([householdId, serviceDate])
  @@index([assetId])
  @@index([vendorId])
  @@map("service_logs")
}

// PropertyDocument - Documents linked to vendors, assets, bills
model PropertyDocument {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  type    DocumentType
  name    String
  fileUrl String       @map("file_url")

  // Connections
  vendorId      String? @map("vendor_id")
  assetId       String? @map("asset_id")
  billAccountId String? @map("bill_account_id")

  // Metadata
  uploadedBy String? @map("uploaded_by")
  notes      String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendor      Vendor?        @relation("DocumentVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  asset       PropertyAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  billAccount BillAccount?   @relation(fields: [billAccountId], references: [id], onDelete: SetNull)

  @@index([householdId, type])
  @@index([vendorId])
  @@index([assetId])
  @@map("property_documents")
}

// OnboardingProgress - Track the homeowner's onboarding journey
model OnboardingProgress {
  id          String @id @default(cuid())
  householdId String @unique @map("household_id")

  // Initial signup
  signupDate       DateTime @default(now()) @map("signup_date")
  biggestChallenge String?  @map("biggest_challenge")
  selectedTier     String?  @map("selected_tier")

  // Onboarding call
  callScheduledFor DateTime? @map("call_scheduled_for")
  callStartedAt    DateTime? @map("call_started_at")
  callCompletedAt  DateTime? @map("call_completed_at")
  callNotes        String?   @map("call_notes") @db.Text

  // Section completion (percentage 0-100)
  familyComplete   Int @default(0) @map("family_complete")
  propertyComplete Int @default(0) @map("property_complete")
  zonesComplete    Int @default(0) @map("zones_complete")
  systemsComplete  Int @default(0) @map("systems_complete")
  assetsComplete   Int @default(0) @map("assets_complete")
  vendorsComplete  Int @default(0) @map("vendors_complete")
  billsComplete    Int @default(0) @map("bills_complete")

  // Flexible intake data (JSON for storing form data during call)
  intakeData Json? @map("intake_data")

  // Follow-up
  followUpNeeded Boolean @default(false) @map("follow_up_needed")
  followUpNotes  String? @map("follow_up_notes") @db.Text

  // Milestones
  profileDeliveredAt     DateTime? @map("profile_delivered_at")
  firstBillPaidAt        DateTime? @map("first_bill_paid_at")
  allBillsConsolidatedAt DateTime? @map("all_bills_consolidated_at")
  thirtyDayReviewAt      DateTime? @map("thirty_day_review_at")
  ninetyDayReviewAt      DateTime? @map("ninety_day_review_at")
  oneYearReviewAt        DateTime? @map("one_year_review_at")

  // Overall status
  status OnboardingStatus @default(PENDING_CALL)

  // Assigned team
  homeManagerId String? @map("home_manager_id")
  handymanId    String? @map("handyman_id")

  // Calculated monthly estimate
  monthlyEstimate Decimal? @map("monthly_estimate") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  homeManager User?     @relation("OnboardingHomeManager", fields: [homeManagerId], references: [id], onDelete: SetNull)
  handyman    User?     @relation("OnboardingHandyman", fields: [handymanId], references: [id], onDelete: SetNull)

  @@map("onboarding_progress")
}

// ============================================================================
// ACTIVITY LOG - Tracks all actions for homeowner visibility
// ============================================================================

model ActivityLog {
  id          String @id @default(cuid())
  householdId String @map("household_id")

  // Who did this
  actorId   String    @map("actor_id")
  actorType ActorType @map("actor_type")
  actorName String    @map("actor_name")

  // What happened
  action      ActivityAction   @map("action")
  category    ActivityCategory @map("category")
  title       String
  description String?          @db.Text

  // Links to related records
  billId   String? @map("bill_id")
  vendorId String? @map("vendor_id")
  assetId  String? @map("asset_id")
  zoneId   String? @map("zone_id")
  taskId   String? @map("task_id")

  // Metadata
  amount   Float?
  metadata Json?

  // Visibility
  visibleToHomeowner Boolean @default(true) @map("visible_to_homeowner")
  visibleToHandyman  Boolean @default(false) @map("visible_to_handyman")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@index([householdId, category])
  @@index([householdId, visibleToHomeowner])
  @@map("activity_logs")
}

// ============================================================================
// APPROVAL SYSTEM - Manager requests homeowner approval for decisions
// ============================================================================

model ApprovalRequest {
  id          String           @id @default(cuid())
  householdId String           @map("household_id")
  requesterId String           @map("requester_id") // Manager who requested
  deciderId   String?          @map("decider_id") // Homeowner who decided

  // Request details
  type        ApprovalType
  priority    ApprovalPriority @default(MEDIUM)
  status      ApprovalStatus   @default(PENDING)
  title       String
  description String?          @db.Text

  // Financial details (for expense approvals)
  amount      Decimal?         @db.Decimal(10, 2)
  vendorName  String?          @map("vendor_name")

  // Related entities
  workOrderId      String? @map("work_order_id")
  serviceRequestId String? @map("service_request_id")
  projectId        String? @map("project_id")

  // Timeline
  expiresAt   DateTime? @map("expires_at")
  decidedAt   DateTime? @map("decided_at")

  // Decision details
  decisionNote String? @map("decision_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  requester User              @relation("ApprovalRequestedBy", fields: [requesterId], references: [id], onDelete: Cascade)
  decider   User?             @relation("ApprovalDecidedBy", fields: [deciderId], references: [id], onDelete: SetNull)
  comments  ApprovalComment[]

  @@index([householdId, status])
  @@index([householdId, createdAt])
  @@index([requesterId])
  @@index([deciderId])
  @@map("approval_requests")
}

model ApprovalComment {
  id         String @id @default(cuid())
  approvalId String @map("approval_id")
  authorId   String @map("author_id")

  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  approval ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  author   User            @relation("ApprovalCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([approvalId, createdAt])
  @@map("approval_comments")
}

// =============================================================================
// DOCUMENT VAULT
// =============================================================================

enum DocumentCategory {
  PROPERTY  // Deed, survey, title, HOA
  INSURANCE // Homeowners, auto, umbrella, life
  WARRANTY  // Appliance and system warranties
  MANUAL    // User manuals, guides
  TAX       // Property tax, assessments
  CONTRACT  // Vendor contracts, service agreements
  RECEIPT   // Invoices, receipts
  PERMIT    // Building permits, certificates
  OTHER
}

model Document {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // File info
  fileName    String   @map("file_name")
  originalName String  @map("original_name")
  mimeType    String   @map("mime_type")
  fileSize    Int      @map("file_size") // bytes
  storageUrl  String   @map("storage_url") // GCS URL
  storagePath String   @map("storage_path") // GCS path for deletion

  // Organization
  category    DocumentCategory
  subcategory String?
  title       String?  // User-friendly title
  description String?

  // Metadata
  tags        String[] @default([])

  // Expiration tracking
  expiresAt       DateTime? @map("expires_at")
  expirationAlert Boolean   @default(false) @map("expiration_alert")

  // Related entities
  vendorId    String? @map("vendor_id")
  vendor      Vendor? @relation("VaultDocumentVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  applianceId String? @map("appliance_id") // Future: link to appliance inventory

  // Access
  uploadedById String @map("uploaded_by_id")
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([householdId])
  @@index([category])
  @@index([expiresAt])
  @@map("documents")
}

// =============================================================================
// PLAID INTEGRATION
// =============================================================================

enum PlaidConnectionStatus {
  ACTIVE
  ERROR
  DISCONNECTED
  PENDING_REAUTH
}

enum DetectedBillStatus {
  PENDING   // Awaiting user review
  CONFIRMED // User confirmed, linked to bill
  DISMISSED // User said "not a bill"
  IGNORED   // User wants to ignore
}

model PlaidConnection {
  id              String               @id @default(cuid())
  householdId     String               @map("household_id")
  household       Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Plaid tokens (encrypted in production)
  accessToken     String               @map("access_token")
  itemId          String               @map("item_id")

  // Institution info
  institutionId   String?              @map("institution_id")
  institutionName String?              @map("institution_name")

  // Connection status
  status          PlaidConnectionStatus @default(ACTIVE)
  lastSyncedAt    DateTime?            @map("last_synced_at")
  errorCode       String?              @map("error_code")
  errorMessage    String?              @map("error_message")

  // Linked accounts
  accounts        PlaidAccount[]

  // Audit
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@unique([householdId, itemId])
  @@index([householdId])
  @@map("plaid_connections")
}

model PlaidAccount {
  id               String          @id @default(cuid())
  connectionId     String          @map("connection_id")
  connection       PlaidConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // Plaid account info
  plaidAccountId   String          @map("plaid_account_id")
  name             String
  officialName     String?         @map("official_name")
  type             String          // checking, savings, credit, etc.
  subtype          String?
  mask             String?         // Last 4 digits

  // Balances (optional, refreshed periodically)
  currentBalance   Float?          @map("current_balance")
  availableBalance Float?          @map("available_balance")

  // Detected recurring transactions
  detectedBills    DetectedBill[]

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([connectionId, plaidAccountId])
  @@map("plaid_accounts")
}

model DetectedBill {
  id              String             @id @default(cuid())
  householdId     String             @map("household_id")
  household       Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  accountId       String?            @map("account_id")
  account         PlaidAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Bill details (detected from transactions)
  merchantName    String             @map("merchant_name")
  normalizedName  String             @map("normalized_name")
  category        BillCategory       @default(OTHER_BILL)

  // Amount pattern
  averageAmount   Float              @map("average_amount")
  lastAmount      Float              @map("last_amount")
  frequency       BillingFrequency   @default(MONTHLY)

  // Timing
  lastTransactionDate DateTime?      @map("last_transaction_date")
  nextExpectedDate    DateTime?      @map("next_expected_date")
  dayOfMonth          Int?           @map("day_of_month")

  // User actions
  status          DetectedBillStatus @default(PENDING)
  managementStatus String            @default("SELF_MANAGED") @map("management_status")  // SELF_MANAGED, PENDING_SETUP, HAVEN_MANAGED
  notes           String?            // User notes for manual bills
  linkedBillId    String?            @map("linked_bill_id")

  // Payment setup (for Haven-managed bills)
  paymentMethod   String?            @map("payment_method")  // CARD, ACH, CHECK
  paymentAccountId String?           @map("payment_account_id")  // Stripe payment method or checkbook.io account

  // Transaction history
  transactionIds  String[]           @default([]) @map("transaction_ids")
  transactionCount Int               @default(0) @map("transaction_count")

  // Check detection (for checkbook.io integration)
  detectionType   String             @default("RECURRING_CHARGE") @map("detection_type")  // RECURRING_CHARGE or RECURRING_CHECK
  checkPayee      String?            @map("check_payee")   // Payee name from check
  checkNumber     String?            @map("check_number")  // Check number if available

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([householdId])
  @@index([status])
  @@index([managementStatus])
  @@map("detected_bills")
}

// ============================================================================
// PAYMENT SYSTEM MODELS
// ============================================================================

model HouseholdCard {
  id                  String   @id @default(cuid())
  householdId         String   @unique @map("household_id")
  household           Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Stripe Issuing
  stripeCardholderId  String?  @map("stripe_cardholder_id")
  stripeCardId        String?  @unique @map("stripe_card_id")
  last4               String?
  expMonth            Int?     @map("exp_month")
  expYear             Int?     @map("exp_year")
  brand               String   @default("visa")
  status              String   @default("pending") // pending, active, frozen, cancelled

  // Funding source (linked via Plaid)
  plaidAccountId      String?  @map("plaid_account_id") // Primary funding source
  fundingStatus       String   @default("not_connected") @map("funding_status") // not_connected, connected, error

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("household_cards")
}

model Bill {
  id                  String   @id @default(cuid())
  householdId         String   @map("household_id")
  household           Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Vendor link (optional - some bills aren't tied to vendors in our system)
  vendorId            String?  @map("vendor_id")
  vendor              HouseholdVendor? @relation(fields: [vendorId], references: [id])

  // Bill details
  name                String
  description         String?
  category            String   // utility, insurance, mortgage, service, subscription, tax, other

  // Amount handling
  amount              Float?   // Null if variable
  isVariableAmount    Boolean  @default(false) @map("is_variable_amount")
  averageAmount       Float?   @map("average_amount") // For variable bills, historical average
  lastKnownAmount     Float?   @map("last_known_amount")

  // Schedule
  frequency           String   // weekly, biweekly, monthly, quarterly, semi_annual, annual, one_time
  dueDay              Int?     @map("due_day") // Day of month (1-31)
  seasonStart         Int?     @map("season_start") // Month (1-12) if seasonal
  seasonEnd           Int?     @map("season_end") // Month (1-12) if seasonal
  nextDueDate         DateTime? @map("next_due_date")

  // Payment method
  paymentMethod       String   @map("payment_method") // card, check_digital, check_physical, manual
  paymentPortalUrl    String?  @map("payment_portal_url") // URL to pay online (for card payments)
  paymentEmail        String?  @map("payment_email") // Vendor email (for digital checks)
  mailingAddress      String?  @map("mailing_address") // Vendor address (for physical checks)
  accountNumber       String?  @map("account_number") // User's account number WITH the vendor

  // Autopay settings
  autopayEnabled      Boolean  @default(true) @map("autopay_enabled")
  requiresApproval    Boolean  @default(false) @map("requires_approval")
  approvalThreshold   Float?   @map("approval_threshold") // Require approval if amount exceeds this
  daysBeforeDue       Int      @default(5) @map("days_before_due") // Pay this many days before due date

  // Risk/Priority
  priority            String   @default("normal") // critical, high, normal, low

  // Status
  status              String   @default("active") // active, paused, cancelled

  // Source tracking
  sourceType          String   @default("manual") @map("source_type") // manual, plaid_detected, alfred
  detectedBillId      String?  @map("detected_bill_id") // Link to DetectedBill if created from detection

  // Relationships
  payments            BillPayment[]
  approvals           PaymentApproval[]

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([householdId, status])
  @@index([nextDueDate])
  @@map("bills")
}

model BillPayment {
  id                  String   @id @default(cuid())
  billId              String   @map("bill_id")
  bill                Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  householdId         String   @map("household_id")

  // Payment details
  amount              Float
  status              String   @default("pending") // pending, processing, completed, failed, cancelled
  paymentMethod       String   @map("payment_method") // card, check_digital, check_physical

  // Stripe (for card payments)
  stripePaymentId     String?  @map("stripe_payment_id")
  stripeAuthId        String?  @map("stripe_auth_id")

  // Checkbook.io (for check payments)
  checkbookCheckId    String?  @map("checkbook_check_id")
  checkNumber         String?  @map("check_number")
  checkTrackingNumber String?  @map("check_tracking_number")

  // Timing
  scheduledDate       DateTime @map("scheduled_date")
  processedDate       DateTime? @map("processed_date")
  confirmedDate       DateTime? @map("confirmed_date")

  // Error handling
  failureReason       String?  @map("failure_reason")
  retryCount          Int      @default(0) @map("retry_count")
  maxRetries          Int      @default(3) @map("max_retries")

  // Approval link
  approvalId          String?  @map("approval_id")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([householdId, status])
  @@index([scheduledDate])
  @@map("bill_payments")
}

model PaymentApproval {
  id                  String   @id @default(cuid())
  householdId         String   @map("household_id")
  household           Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  billId              String   @map("bill_id")
  bill                Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  // Approval details
  amount              Float
  reason              String   // high_amount, first_payment, anomaly, critical_bill, manual_request

  // Status
  status              String   @default("pending") // pending, approved, denied, expired, auto_approved

  // Timing
  requestedAt         DateTime @default(now()) @map("requested_at")
  respondedAt         DateTime? @map("responded_at")
  expiresAt           DateTime @map("expires_at")

  // Who responded
  respondedBy         String?  @map("responded_by") // User ID
  responseNote        String?  @map("response_note")

  // Resulting payment
  paymentId           String?  @map("payment_id")

  createdAt           DateTime @default(now()) @map("created_at")

  @@index([householdId, status])
  @@index([expiresAt])
  @@map("payment_approvals")
}
