{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd operations && npm install --no-audit --no-fund && npm run build",
  "outputDirectory": ".",
  "installCommand": "echo 'Skipping root install — operations app installs its own deps via buildCommand.'",
  "framework": null,
  "rewrites": [
    {
      "source": "/operations/assets/:path*",
      "destination": "/operations/dist/assets/:path*"
    },
    {
      "source": "/operations",
      "destination": "/operations/dist/index.html"
    },
    {
      "source": "/operations/:path*",
      "destination": "/operations/dist/index.html"
    }
  ],
  "headers": [
    {
      "source": "/operations/dist/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
